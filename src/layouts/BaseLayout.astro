---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ReadingSettings from '../components/ReadingSettings.astro';
import { siteConfig } from '../config/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  updatedTime?: Date;
}
const {
  title,
  description = siteConfig.description,
  image = '/og-default.svg',
  canonical,
  type = 'website',
  publishedTime,
  updatedTime,
} = Astro.props;
const pageTitle = title
  ? `${title} · ${siteConfig.name}`
  : `${siteConfig.name} · About Me`;
const canonicalUrl =
  canonical || new URL(Astro.url.pathname, siteConfig.site).toString();
const imageUrl = new URL(image, siteConfig.site).toString();
const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        url: canonicalUrl,
        image: imageUrl,
        datePublished: publishedTime?.toISOString(),
        dateModified: (updatedTime || publishedTime)?.toISOString(),
        author: {
          '@type': 'Person',
          name: siteConfig.author.name,
          url: siteConfig.author.github,
        },
        publisher: { '@type': 'Organization', name: siteConfig.name },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteConfig.name,
        alternateName: siteConfig.englishName,
        url: siteConfig.site,
        description,
        inLanguage: siteConfig.locale,
      };
---

<!doctype html>
<html
  lang="zh-CN"
  style={`--reader-font-size:${siteConfig.reading.fontSize}px;--reader-line-height:${siteConfig.reading.lineHeight};--measure:${siteConfig.reading.contentWidth}rem`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.name} RSS`}
      href="/rss.xml"
    />
    <link
      rel="icon"
      href={siteConfig.author.avatar}
      type="image/png"
      sizes="any"
    />
    <link
      rel="apple-touch-icon"
      href={siteConfig.author.avatar}
      sizes="180x180"
    />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    {publishedTime && (
      <meta
        property="article:published_time"
        content={publishedTime.toISOString()}
      />
    )}
    {updatedTime && (
      <meta
        property="article:modified_time"
        content={updatedTime.toISOString()}
      />
    )}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const dark = matchMedia('(prefers-color-scheme: dark)').matches;
        let saved;
        try {
          saved = localStorage.getItem('prism-theme');
        } catch {}
        root.dataset.theme =
          saved === 'dark' || saved === 'light'
            ? saved
            : dark
              ? 'dark'
              : 'light';
        document.querySelector('meta[name="theme-color"]').content =
          root.dataset.theme === 'dark' ? '#1d1e20' : '#ffffff';
        try {
          const s = JSON.parse(
            localStorage.getItem('prism-reader-settings') || '{}',
          );
          if (s.fontSize >= 15 && s.fontSize <= 22)
            root.style.setProperty('--reader-font-size', `${s.fontSize}px`);
          if (s.lineHeight >= 1.5 && s.lineHeight <= 2.1)
            root.style.setProperty('--reader-line-height', s.lineHeight);
          if (s.contentWidth >= 38 && s.contentWidth <= 52)
            root.style.setProperty('--measure', `${s.contentWidth}rem`);
        } catch {}
      })();
    </script>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      跳到正文
    </a>
    <Header article={type === 'article'} />
    {type === 'article' && <ReadingSettings />}
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    {siteConfig.analytics.enabled && siteConfig.analytics.scriptUrl && (
      <script is:inline async src={siteConfig.analytics.scriptUrl}></script>
    )}
  </body>
</html>
