---
import { siteConfig } from '../config/site';
---

<footer class="footer shell">
  <nav aria-label="页脚导航">
    <a href="/rss.xml">RSS</a>
    <a href={siteConfig.author.github} rel="me">
      GitHub
    </a>
    <a href="/archive/">归档</a>
    <a href="/categories/">分类</a>
    <a href="/tags/">标签</a>
  </nav>
  <p>
    © {new Date().getFullYear()} <a href="/">{siteConfig.author.name}</a> ·
    Built with Astro
  </p>
</footer>
<style>
  .footer {
    padding-block: 2rem 2.5rem;
    color: var(--muted-ink);
    font-size: 0.8rem;
    text-align: center;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
  }
  nav a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  p {
    margin: 0.5rem 0 0;
  }
  p a {
    text-decoration: none;
  }
</style>
