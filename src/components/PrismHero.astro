---
import { siteConfig } from '../config/site';
---
<section class="hero">
  <div class="shell title-page">
    <p class="series">{siteConfig.hero.eyebrow}</p>
    <div class="rule" aria-hidden="true"></div>
    <h1>{siteConfig.hero.title.split('\n').map((line) => <span>{line}</span>)}</h1>
    <p class="subtitle">{siteConfig.hero.introduction}</p>
    <p class="author">{siteConfig.author.name}</p>
    <p class="date">{new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long' }).format(new Date())}</p>
    <nav class="hero-actions" aria-label="首页快捷入口">
      <a href="/blog/">开始阅读</a><span aria-hidden="true">·</span><a href="/archive/">文章索引</a><span aria-hidden="true">·</span><a href="/about/">关于作者</a>
    </nav>
  </div>
</section>
<style>
  .hero{min-height:calc(100dvh - 66px);display:grid;place-items:center;padding:4rem 0 5rem;border-bottom:1px solid var(--soft-line)}
  .title-page{max-width:54rem;text-align:center}.series{margin:0;font:500 .78rem var(--font-sans);letter-spacing:.15em;text-transform:uppercase;color:var(--muted-ink)}
  .rule{width:4.5rem;margin:2.25rem auto;border-top:1px solid var(--ink)}
  h1{max-width:48rem;margin:0 auto;font-size:clamp(3rem,8vw,6rem);font-weight:500;line-height:1.08;letter-spacing:-.025em}h1 span{display:block}
  .subtitle{max-width:38rem;margin:2rem auto 0;font-size:clamp(1.1rem,2.3vw,1.35rem);font-style:italic;color:var(--muted-ink)}
  .author{margin:3.5rem 0 .15rem;font-variant:small-caps;letter-spacing:.08em}.date{margin:0;color:var(--muted-ink);font-size:.92rem}
  .hero-actions{display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:.7rem;margin-top:3.5rem;font-family:var(--font-sans);font-size:.88rem}.hero-actions a{min-height:44px;display:inline-flex;align-items:center}
  @media(max-width:520px){.hero{min-height:auto;padding-block:5rem}.rule{margin-block:1.75rem}.author{margin-top:2.5rem}.hero-actions{margin-top:2.5rem}}
</style>
