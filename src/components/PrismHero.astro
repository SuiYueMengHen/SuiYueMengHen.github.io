---
import { siteConfig } from '../config/site';
const titleLines = siteConfig.hero.title.split('\n');
---
<section class="hero" data-prism-hero>
  <div class="hero-sticky">
    <div class="hero-inner shell">
      <p class="eyebrow"><span>PRISM NOTES</span><i aria-hidden="true"></i><span>棱镜笔记</span></p>

      <div class="title-stage">
        <div class="prism-stage" data-prism-stage role="img" aria-label="一束光穿过透明三维棱镜并被折射为光谱">
          <svg viewBox="0 0 760 420" aria-hidden="true">
            <defs>
              <linearGradient id="glass-a" x1="0" y1="0" x2="1" y2="1"><stop stop-color="var(--ink)" stop-opacity=".055"/><stop offset="1" stop-color="var(--spectrum-blue)" stop-opacity=".14"/></linearGradient>
              <linearGradient id="glass-b" x1="1" y1="0" x2="0" y2="1"><stop stop-color="var(--paper)" stop-opacity=".72"/><stop offset="1" stop-color="var(--spectrum-cyan)" stop-opacity=".11"/></linearGradient>
              <linearGradient id="spectrum" x1="0" y1="0" x2="1" y2="0"><stop stop-color="var(--spectrum-blue)"/><stop offset=".5" stop-color="var(--spectrum-cyan)"/><stop offset="1" stop-color="var(--spectrum-red)"/></linearGradient>
            </defs>
            <path class="incident" d="M28 210 310 210"/>
            <g class="glass">
              <path d="m380 38 154 304-154-78Z" fill="url(#glass-a)"/>
              <path d="m380 38-154 304 154-78Z" fill="url(#glass-b)"/>
              <path d="M226 342h308l-154-78Z" class="base"/>
              <path d="M380 38 534 342H226L380 38Zm0 0v226m154 78-154-78-154 78" class="wire"/>
            </g>
            <g class="spectrum-rays">
              <path d="M380 210 732 164"/>
              <path d="M380 210 732 210"/>
              <path d="M380 210 732 256"/>
            </g>
          </svg>
        </div>

        <h1>{titleLines.map((line) => <span>{line}</span>)}</h1>
      </div>

      <div class="hero-bottom">
        <p>{siteConfig.hero.introduction}</p>
        <div class="actions">
          <a href="/blog/">进入合集 <span aria-hidden="true">↘</span></a>
          <a href="/archive/">浏览归档</a>
        </div>
      </div>
    </div>
    <div class="scroll-mark" aria-hidden="true"><span></span><b>SCROLL</b></div>
  </div>
</section>

<script>
  const hero=document.querySelector<HTMLElement>('[data-prism-hero]');
  const reduce=matchMedia('(prefers-reduced-motion: reduce)');
  let frame=0;
  const render=()=>{
    frame=0;if(!hero||reduce.matches)return;
    const rect=hero.getBoundingClientRect();
    const distance=Math.max(1,rect.height-innerHeight);
    const progress=Math.max(0,Math.min(1,-rect.top/distance));
    hero.style.setProperty('--prism-y',`${progress*-38}px`);
    hero.style.setProperty('--prism-turn',`${progress*20}deg`);
    hero.style.setProperty('--prism-tilt',`${progress*-4}deg`);
    hero.style.setProperty('--prism-scale',String(1+progress*.08));
    hero.style.setProperty('--ray-scale',String(.2+progress*.8));
    hero.style.setProperty('--copy-y',`${progress*-18}px`);
    hero.style.setProperty('--copy-opacity',String(1-progress*.5));
  };
  const schedule=()=>{if(!frame)frame=requestAnimationFrame(render)};
  addEventListener('scroll',schedule,{passive:true});addEventListener('resize',schedule,{passive:true});reduce.addEventListener('change',schedule);schedule();
</script>

<style>
  .hero{--prism-y:0px;--prism-turn:0deg;--prism-tilt:0deg;--prism-scale:1;--ray-scale:.2;--copy-y:0px;--copy-opacity:1;position:relative;height:136dvh;min-height:52rem;border-bottom:1px solid var(--soft-line);background:var(--paper)}
  .hero-sticky{position:sticky;top:66px;height:calc(100dvh - 66px);min-height:40rem;display:grid;place-items:center;overflow:hidden;isolation:isolate}
  .hero-sticky::before{content:'';position:absolute;inset:8% 18%;z-index:-1;background:radial-gradient(circle,color-mix(in srgb,var(--spectrum-blue) 5%,transparent),transparent 66%);pointer-events:none}
  .hero-inner{width:100%;display:grid;justify-items:center;align-content:center;padding-block:clamp(2.5rem,7vh,5rem)}
  .eyebrow{width:min(100%,54rem);display:flex;align-items:center;gap:1rem;margin:0 0 clamp(2rem,5vh,4rem);font:500 .6rem/1 var(--font-sans);letter-spacing:.17em;color:var(--muted-ink);transform:translate3d(0,var(--copy-y),0);opacity:var(--copy-opacity)}.eyebrow i{flex:1;border-top:1px solid var(--soft-line)}
  .title-stage{position:relative;width:min(100%,70rem);min-height:clamp(19rem,48vh,31rem);display:grid;place-items:center;perspective:1100px;transform-style:preserve-3d}
  h1{position:relative;z-index:2;width:100%;margin:0;display:grid;gap:clamp(3.7rem,10vh,6.8rem);text-align:center;font-size:clamp(3.3rem,7.9vw,8rem);font-weight:500;line-height:.88;letter-spacing:-.06em;text-wrap:balance;transform:translate3d(0,var(--copy-y),60px);opacity:var(--copy-opacity);pointer-events:none}h1 span{display:block}
  .prism-stage{position:absolute;inset:0;z-index:1;width:min(78vw,47rem);height:auto;aspect-ratio:760/420;margin:auto;transform-style:preserve-3d;transform:translate3d(0,var(--prism-y),0) rotateX(calc(-2deg + var(--prism-tilt))) rotateY(var(--prism-turn)) scale(var(--prism-scale));will-change:transform}.prism-stage svg{width:100%;height:100%;overflow:visible}.glass{transform-origin:380px 215px;filter:drop-shadow(0 1.6rem 1.8rem color-mix(in srgb,var(--ink) 8%,transparent))}.base{fill:color-mix(in srgb,var(--spectrum-cyan) 7%,transparent)}.wire{fill:none;stroke:color-mix(in srgb,var(--ink) 72%,transparent);stroke-width:1}.incident{fill:none;stroke:color-mix(in srgb,var(--ink) 52%,transparent);stroke-width:1}.spectrum-rays{fill:none;stroke:url(#spectrum);stroke-width:1.15;transform-origin:380px 210px;transform:scaleX(var(--ray-scale));opacity:.62}
  .hero-bottom{width:min(100%,54rem);display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;gap:3rem;margin-top:clamp(1.5rem,4vh,3rem);transform:translate3d(0,var(--copy-y),0);opacity:var(--copy-opacity)}.hero-bottom>p{max-width:32rem;margin:0;color:var(--muted-ink);font-size:clamp(.96rem,1.5vw,1.08rem);line-height:1.7}.actions{display:flex;align-items:center;gap:1.5rem}.actions a{min-height:44px;display:inline-flex;align-items:center;gap:.55rem;font:500 .76rem var(--font-sans);text-decoration:none}.actions a:first-child{border-bottom:1px solid var(--ink)}.actions a span{font-size:1rem;transition:transform .2s ease}.actions a:hover span{transform:translate(2px,2px)}
  .scroll-mark{position:absolute;right:clamp(1rem,3vw,2.5rem);bottom:1.3rem;display:flex;align-items:center;gap:.65rem;color:var(--muted-ink);writing-mode:vertical-rl}.scroll-mark span{height:2.5rem;border-left:1px solid currentColor}.scroll-mark b{font:500 .52rem var(--font-sans);letter-spacing:.16em}
  @media(max-width:760px){.hero{height:124dvh;min-height:46rem}.hero-sticky{min-height:37rem}.eyebrow{margin-bottom:1.5rem}.title-stage{min-height:22rem}.prism-stage{width:min(112vw,39rem)}h1{gap:5rem;font-size:clamp(3.15rem,13.2vw,5.5rem)}.hero-bottom{grid-template-columns:1fr;justify-items:center;gap:1rem;text-align:center}.actions{gap:1.2rem}.scroll-mark{display:none}}
  @media(max-width:430px){.eyebrow{font-size:.53rem}.title-stage{min-height:20rem}h1{gap:4.5rem}.prism-stage{width:118vw}.hero-bottom>p{max-width:21rem}}
  @media(prefers-reduced-motion:reduce){.hero{height:auto;min-height:calc(100dvh - 66px)}.hero-sticky{position:relative;top:0}.eyebrow,h1,.hero-bottom,.prism-stage{transform:none!important;opacity:1!important}.spectrum-rays{transform:scaleX(1)}}
</style>
