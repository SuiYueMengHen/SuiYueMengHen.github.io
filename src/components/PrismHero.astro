---
import { siteConfig } from '../config/site';
const titleLines = siteConfig.hero.title.split('\n');
---
<section class="hero" data-prism-hero>
  <div class="hero-sticky">
    <div class="aura" aria-hidden="true"></div>
    <div class="hero-inner shell">
      <p class="eyebrow"><span>PRISM NOTES</span><i aria-hidden="true"></i><span>∞ / CONTINUUM</span></p>

      <div class="composition">
        <div class="mobius-stage" data-prism-stage role="img" aria-label="由粒子和鳞片组成、随鼠标运动的三维莫比乌斯环">
          <canvas data-mobius-canvas></canvas>
        </div>
        <h1>{titleLines.map((line) => <span>{line}</span>)}</h1>
      </div>

      <div class="hero-bottom">
        <p>{siteConfig.hero.introduction}</p>
        <nav aria-label="首页快捷入口"><a href="/blog/">进入合集 <span aria-hidden="true">↘</span></a><a href="/archive/">浏览归档</a></nav>
      </div>
    </div>
    <p class="interaction-hint" aria-hidden="true"><span></span> MOVE / SCROLL</p>
  </div>
</section>

<script>
  const hero=document.querySelector<HTMLElement>('[data-prism-hero]');
  const canvas=hero?.querySelector<HTMLCanvasElement>('[data-mobius-canvas]');
  const stage=hero?.querySelector<HTMLElement>('[data-prism-stage]');
  const context=canvas?.getContext('2d');
  const reduce=matchMedia('(prefers-reduced-motion: reduce)');
  const fine=matchMedia('(pointer: fine)');
  let width=0,height=0,dpr=1,frame=0,visible=true,last=0;
  let pointerX=.5,pointerY=.5,targetX=.5,targetY=.5,scrollProgress=0,pointerActive=false;
  let palette={ink:'#151515',paper:'#f7f7f7',mid:'#777777'};

  type Point={x:number;y:number;z:number};
  type Projected=Point&{sx:number;sy:number;depth:number};
  const particles=Array.from({length:420},(_,index)=>({u:(index*.61803398875%1)*Math.PI*2,v:((index*37)%101)/50-1,size:.42+(index%5)*.2,speed:.000022+(index%7)*.000004}));
  const streams=Array.from({length:72},(_,index)=>({u:index/72*Math.PI*2,v:Math.sin(index*2.17)*.82,speed:.00016+(index%6)*.000012,length:.025+(index%5)*.008}));
  const cssColor=(name:string,fallback:string)=>getComputedStyle(hero!).getPropertyValue(name).trim()||fallback;
  const updatePalette=()=>{palette={ink:cssColor('--hero-fg','#151515'),paper:cssColor('--hero-bg','#f7f7f7'),mid:cssColor('--hero-mid','#777777')}};

  const rotate=(point:Point,rx:number,ry:number,rz:number):Point=>{
    let {x,y,z}=point;let c=Math.cos(rx),s=Math.sin(rx);[y,z]=[y*c-z*s,y*s+z*c];c=Math.cos(ry);s=Math.sin(ry);[x,z]=[x*c+z*s,-x*s+z*c];c=Math.cos(rz);s=Math.sin(rz);[x,y]=[x*c-y*s,x*s+y*c];return{x,y,z};
  };
  const surface=(u:number,v:number,lift=0):Point=>{const radius=1.52,half=.72;const radial=radius+v*half*Math.cos(u/2)+lift;return{x:radial*Math.cos(u),y:radial*Math.sin(u),z:v*half*Math.sin(u/2)}};
  const project=(point:Point,rx:number,ry:number,rz:number):Projected=>{const p=rotate(point,rx,ry,rz);const perspective=4.35/(4.35-p.z);const factor=width>=1000?.305:width>=620?.272:.255;const scale=Math.min(width,height)*factor;return{...p,sx:width/2+p.x*scale*perspective,sy:height/2-p.y*scale*perspective,depth:p.z}};

  const resize=()=>{
    if(!canvas||!stage||!context)return;const rect=stage.getBoundingClientRect();width=Math.max(1,rect.width);height=Math.max(1,rect.height);dpr=Math.min(devicePixelRatio||1,1.6);canvas.width=Math.round(width*dpr);canvas.height=Math.round(height*dpr);canvas.style.width=`${width}px`;canvas.style.height=`${height}px`;context.setTransform(dpr,0,0,dpr,0,0);draw(performance.now());
  };
  const draw=(time:number)=>{
    if(!context||!canvas)return;context.clearRect(0,0,width,height);pointerX+=(targetX-pointerX)*.055;pointerY+=(targetY-pointerY)*.055;
    const still=reduce.matches;const rx=.9+(pointerY-.5)*.42+scrollProgress*.14;const ry=(still?.18:time*.000082)+(pointerX-.5)*.72+scrollProgress*.52;const rz=-.1+(pointerX-.5)*.1;
    const uCount=width<560?48:width<900?62:82,vCount=width<560?6:width<900?8:10;const tiles:{points:Projected[];depth:number;tone:number;hover:number}[]=[];
    const mouseX=pointerX*width,mouseY=pointerY*height;
    if(pointerActive&&fine.matches){const field=context.createRadialGradient(mouseX,mouseY,0,mouseX,mouseY,150);field.addColorStop(0,palette.ink);field.addColorStop(1,palette.paper);context.globalAlpha=.045;context.fillStyle=field;context.beginPath();context.arc(mouseX,mouseY,150,0,Math.PI*2);context.fill()}
    for(let i=0;i<uCount;i++)for(let j=0;j<vCount;j++){
      const u0=i/uCount*Math.PI*2,u1=(i+1)/uCount*Math.PI*2,v0=-1+j/vCount*2,v1=-1+(j+1)/vCount*2;
      let points=[surface(u0,v0),surface(u1,v0),surface(u1,v1),surface(u0,v1)].map(point=>project(point,rx,ry,rz));
      const sx=points.reduce((sum,p)=>sum+p.sx,0)/4,sy=points.reduce((sum,p)=>sum+p.sy,0)/4;points=points.map(point=>({...point,sx:sx+(point.sx-sx)*.9,sy:sy+(point.sy-sy)*.9}));const distance=Math.hypot(sx-mouseX,sy-mouseY);tiles.push({points,depth:points.reduce((sum,p)=>sum+p.depth,0)/4,tone:(i+j)%5,hover:pointerActive&&fine.matches?Math.max(0,1-distance/165):0});
    }
    tiles.sort((a,b)=>a.depth-b.depth);context.lineJoin='round';
    for(const tile of tiles){context.beginPath();tile.points.forEach((point,index)=>index?context.lineTo(point.sx,point.sy):context.moveTo(point.sx,point.sy));context.closePath();const front=Math.max(0,Math.min(1,(tile.depth+1.9)/3.8));context.globalAlpha=.055+front*.2+(tile.tone===0?.035:0)+tile.hover*.3;context.fillStyle=tile.tone<2?palette.ink:palette.mid;context.fill();context.globalAlpha=.16+front*.12+tile.hover*.5;context.strokeStyle=tile.hover>.08?palette.ink:palette.paper;context.lineWidth=.45+tile.hover*1.1;context.stroke()}
    context.save();context.strokeStyle=palette.ink;context.lineCap='round';context.shadowColor=palette.ink;context.shadowBlur=11;
    for(const stream of streams){const u=stream.u+(still?0:time*stream.speed);const head=project(surface(u,stream.v,.055),rx,ry,rz),tail=project(surface(u-stream.length,stream.v,.045),rx,ry,rz);context.beginPath();context.moveTo(tail.sx,tail.sy);context.lineTo(head.sx,head.sy);context.globalAlpha=.22+Math.max(0,head.depth)*.16;context.lineWidth=.65+Math.max(0,head.depth)*.45;context.stroke()}context.restore();
    for(const particle of particles){const lift=.035+Math.sin(particle.u*5+time*.001)*.025;const point=project(surface(particle.u+(still?0:time*particle.speed),particle.v,lift),rx,ry,rz);let x=point.sx,y=point.sy;const dx=x-mouseX,dy=y-mouseY,distance=Math.hypot(dx,dy);const influence=pointerActive&&fine.matches?Math.max(0,1-distance/145):0;if(influence){const push=influence*29;x+=dx/(distance||1)*push;y+=dy/(distance||1)*push}context.beginPath();context.arc(x,y,particle.size+influence*1.65,0,Math.PI*2);context.globalAlpha=.24+Math.max(0,point.depth)*.15+influence*.65;context.fillStyle=particle.v>0?palette.ink:palette.mid;context.fill()}
    context.globalAlpha=1;if(visible&&!still){frame=requestAnimationFrame(draw);last=time}else frame=0;
  };
  const start=()=>{if(!frame&&visible)frame=requestAnimationFrame(draw)};
  const onPointer=(event:PointerEvent)=>{if(!hero||!fine.matches)return;pointerActive=true;const rect=hero.getBoundingClientRect();targetX=Math.max(0,Math.min(1,(event.clientX-rect.left)/rect.width));targetY=Math.max(0,Math.min(1,(event.clientY-rect.top)/Math.min(rect.height,innerHeight)));start()};
  const onScroll=()=>{if(!hero)return;const rect=hero.getBoundingClientRect();scrollProgress=Math.max(0,Math.min(1,-rect.top/Math.max(1,rect.height-innerHeight)));hero.style.setProperty('--stage-y',`${scrollProgress*-34}px`);hero.style.setProperty('--stage-scale',String(1+scrollProgress*.07));hero.style.setProperty('--copy-y',`${scrollProgress*-18}px`);hero.style.setProperty('--copy-opacity',String(1-scrollProgress*.48));start()};
  new ResizeObserver(resize).observe(stage!);new IntersectionObserver(([entry])=>{visible=entry.isIntersecting;if(visible)start();else if(frame){cancelAnimationFrame(frame);frame=0}},{rootMargin:'100px'}).observe(hero!);
  hero?.addEventListener('pointermove',onPointer,{passive:true});hero?.addEventListener('pointerleave',()=>{pointerActive=false;targetX=.5;targetY=.5;start()},{passive:true});addEventListener('scroll',onScroll,{passive:true});
  window.addEventListener('prism-theme-change',()=>{updatePalette();start()});reduce.addEventListener('change',()=>{if(frame)cancelAnimationFrame(frame);frame=0;draw(last)});updatePalette();onScroll();resize();
</script>

<style>
  .hero{--hero-bg:var(--paper);--hero-fg:var(--ink);--hero-mid:var(--muted-ink);--stage-x:0%;--stage-y:0px;--stage-scale:1;--copy-y:0px;--copy-opacity:1;position:relative;height:140dvh;min-height:58rem;border-bottom:1px solid var(--soft-line);background:var(--paper)}
  .hero-sticky{position:sticky;top:66px;height:calc(100dvh - 66px);min-height:42rem;display:grid;place-items:center;overflow:hidden;isolation:isolate}.aura{position:absolute;inset:4% 8%;z-index:-1;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--hero-fg) 8%,transparent),transparent 62%);filter:blur(28px)}
  .hero-inner{width:100%;display:grid;justify-items:center;align-content:center;padding-block:clamp(2rem,4.5vh,3.5rem)}.eyebrow{z-index:3;width:min(100%,64rem);display:flex;align-items:center;gap:1rem;margin:0 0 clamp(1rem,2vh,1.7rem);font:500 .58rem var(--font-sans);letter-spacing:.17em;color:var(--muted-ink);transform:translate3d(0,var(--copy-y),0);opacity:var(--copy-opacity)}.eyebrow i{flex:1;border-top:1px solid var(--soft-line)}
  .composition{position:relative;width:min(100%,88rem);height:clamp(31rem,70vh,48rem);display:grid;place-items:center}.mobius-stage{position:absolute;inset:0;z-index:1;width:min(112vw,86rem);height:100%;margin:auto;transform:translate3d(var(--stage-x),var(--stage-y),0) scale(var(--stage-scale));will-change:transform}.mobius-stage canvas{display:block;width:100%;height:100%}
  h1{position:relative;z-index:2;width:100%;display:grid;gap:clamp(3.25rem,7vh,5.25rem);margin:0;text-align:center;font-size:clamp(3.2rem,7.6vw,7.7rem);font-weight:500;line-height:.86;letter-spacing:-.06em;text-wrap:balance;transform:translate3d(0,var(--copy-y),0);opacity:var(--copy-opacity);pointer-events:none}h1 span{display:block;white-space:nowrap;text-shadow:0 0 1.5rem var(--hero-bg),0 0 .35rem var(--hero-bg)}
  .hero-bottom{z-index:3;width:min(100%,58rem);display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;gap:3rem;margin-top:clamp(.8rem,2vh,1.5rem);transform:translate3d(0,var(--copy-y),0);opacity:var(--copy-opacity)}.hero-bottom>p{max-width:34rem;margin:0;color:var(--muted-ink);line-height:1.7}.hero-bottom nav{display:flex;align-items:center;gap:1.5rem}.hero-bottom a{min-height:44px;display:inline-flex;align-items:center;gap:.55rem;font:500 .76rem var(--font-sans);text-decoration:none}.hero-bottom a:first-child{border-bottom:1px solid var(--ink)}.hero-bottom a span{font-size:1rem;transition:transform .2s ease}.hero-bottom a:hover span{transform:translate(2px,2px)}
  .interaction-hint{position:absolute;right:clamp(1rem,3vw,2.5rem);bottom:1.3rem;display:flex;align-items:center;gap:.65rem;margin:0;writing-mode:vertical-rl;font:500 .5rem var(--font-sans);letter-spacing:.14em;color:var(--muted-ink)}.interaction-hint span{height:2.3rem;border-left:1px solid currentColor}
  @media(max-width:1024px){.hero{--stage-x:-2.5%;height:132dvh}.composition{height:clamp(27rem,57vh,34rem)}.mobius-stage{width:min(116vw,62rem)}h1{gap:clamp(3rem,6vh,4.4rem);font-size:clamp(3.2rem,9.2vw,6.3rem)}.hero-bottom{width:min(100%,54rem)}}
  @media(max-width:760px){.hero{--stage-x:-7%;height:123dvh;min-height:47rem}.hero-sticky{min-height:38rem}.hero-inner{padding-block:1.6rem}.eyebrow{margin-bottom:.65rem}.composition{height:clamp(23rem,51vh,27rem)}.mobius-stage{width:146vw}h1{gap:clamp(2.45rem,5.5vh,3.35rem);font-size:clamp(2rem,9vw,2.55rem);line-height:.92}.hero-bottom{grid-template-columns:1fr;justify-items:center;gap:.7rem;margin-top:.4rem;text-align:center}.hero-bottom>p{font-size:.94rem;line-height:1.58}.hero-bottom nav{gap:1.15rem}.interaction-hint{display:none}}
  @media(max-width:430px){.hero{--stage-x:-9%}.eyebrow{font-size:.49rem}.composition{height:22.5rem}.mobius-stage{width:162vw}h1{gap:2.45rem;font-size:clamp(2rem,9vw,2.45rem)}.hero-bottom>p{max-width:20rem}.hero-bottom nav{gap:.85rem}}
  @media(prefers-reduced-motion:reduce){.hero{height:auto;min-height:calc(100dvh - 66px)}.hero-sticky{position:relative;top:0}.eyebrow,h1,.hero-bottom,.mobius-stage{transform:none!important;opacity:1!important}.interaction-hint{display:none}}
</style>
