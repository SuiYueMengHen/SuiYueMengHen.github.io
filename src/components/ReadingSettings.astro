---
import { siteConfig } from '../config/site';
const defaults = siteConfig.reading;
---
<dialog id="reading-settings" aria-labelledby="settings-title" data-font-size={defaults.fontSize} data-line-height={defaults.lineHeight} data-content-width={defaults.contentWidth} data-paragraph-indent={String(defaults.paragraphIndent)}>
  <form method="dialog" class="settings-panel">
    <header><div><p>Reader preferences</p><h2 id="settings-title">阅读设置</h2></div><button class="close" value="close" aria-label="关闭阅读设置">×</button></header>
    <div class="setting"><label for="font-size">正文字号 <output id="font-size-value">{defaults.fontSize} px</output></label><input id="font-size" name="fontSize" type="range" min="15" max="22" step="1" value={defaults.fontSize} /></div>
    <div class="setting"><label for="line-height">行距 <output id="line-height-value">{defaults.lineHeight}</output></label><input id="line-height" name="lineHeight" type="range" min="1.5" max="2.1" step="0.05" value={defaults.lineHeight} /></div>
    <div class="setting"><label for="content-width">版心宽度 <output id="content-width-value">{defaults.contentWidth} rem</output></label><input id="content-width" name="contentWidth" type="range" min="38" max="52" step="1" value={defaults.contentWidth} /></div>
    <label class="check"><input id="paragraph-indent" name="paragraphIndent" type="checkbox" checked={defaults.paragraphIndent} /><span>正文段首缩进两格</span></label>
    <footer><button id="settings-reset" type="button">恢复默认</button><button class="apply" value="close">完成</button></footer>
  </form>
</dialog>
<script>
  type ReaderSettings={fontSize:number;lineHeight:number;contentWidth:number;paragraphIndent:boolean};
  const dialog=document.querySelector<HTMLDialogElement>('#reading-settings');
  const defaults:ReaderSettings={fontSize:Number(dialog?.dataset.fontSize||17),lineHeight:Number(dialog?.dataset.lineHeight||1.85),contentWidth:Number(dialog?.dataset.contentWidth||46),paragraphIndent:dialog?.dataset.paragraphIndent!=='false'};
  const trigger=document.querySelector<HTMLButtonElement>('#settings-toggle');
  const controls={fontSize:document.querySelector<HTMLInputElement>('#font-size'),lineHeight:document.querySelector<HTMLInputElement>('#line-height'),contentWidth:document.querySelector<HTMLInputElement>('#content-width'),paragraphIndent:document.querySelector<HTMLInputElement>('#paragraph-indent')};
  const outputs={fontSize:document.querySelector<HTMLOutputElement>('#font-size-value'),lineHeight:document.querySelector<HTMLOutputElement>('#line-height-value'),contentWidth:document.querySelector<HTMLOutputElement>('#content-width-value')};
  const read=():ReaderSettings=>{try{return{...defaults,...JSON.parse(localStorage.getItem('prism-reader-settings')||'{}')}}catch{return defaults}};
  const apply=(settings:ReaderSettings,persist=true)=>{const root=document.documentElement;root.style.setProperty('--reader-font-size',`${settings.fontSize}px`);root.style.setProperty('--reader-line-height',String(settings.lineHeight));root.style.setProperty('--measure',`${settings.contentWidth}rem`);root.style.setProperty('--paragraph-indent',settings.paragraphIndent?'2em':'0');if(persist)localStorage.setItem('prism-reader-settings',JSON.stringify(settings));if(controls.fontSize)controls.fontSize.value=String(settings.fontSize);if(controls.lineHeight)controls.lineHeight.value=String(settings.lineHeight);if(controls.contentWidth)controls.contentWidth.value=String(settings.contentWidth);if(controls.paragraphIndent)controls.paragraphIndent.checked=settings.paragraphIndent;if(outputs.fontSize)outputs.fontSize.value=`${settings.fontSize} px`;if(outputs.lineHeight)outputs.lineHeight.value=settings.lineHeight.toFixed(2);if(outputs.contentWidth)outputs.contentWidth.value=`${settings.contentWidth} rem`;window.dispatchEvent(new CustomEvent('reader-settings-change',{detail:settings}))};
  const fromControls=():ReaderSettings=>({fontSize:Number(controls.fontSize?.value||17),lineHeight:Number(controls.lineHeight?.value||1.85),contentWidth:Number(controls.contentWidth?.value||46),paragraphIndent:Boolean(controls.paragraphIndent?.checked)});
  apply(read(),false);
  trigger?.addEventListener('click',()=>dialog?.showModal());
  dialog?.addEventListener('click',(event)=>{if(event.target===dialog)dialog.close()});
  Object.values(controls).forEach((control)=>control?.addEventListener('input',()=>apply(fromControls())));
  document.querySelector('#settings-reset')?.addEventListener('click',()=>apply(defaults));
</script>
<style>
  dialog{width:min(92vw,29rem);max-height:min(88dvh,42rem);padding:0;border:1px solid var(--ink);border-radius:2px;background:var(--paper);color:var(--ink);box-shadow:0 1.5rem 5rem #0003}dialog::backdrop{background:#1118;backdrop-filter:blur(2px)}.settings-panel{padding:1.5rem}.settings-panel header{display:flex;justify-content:space-between;align-items:start;padding-bottom:1.25rem;border-bottom:1px solid var(--ink)}header p{margin:0 0 .25rem;font:500 .67rem var(--font-sans);letter-spacing:.12em;text-transform:uppercase;color:var(--muted-ink)}header h2{margin:0;font-size:1.65rem;font-weight:500}.close{width:44px;height:44px;border:0;background:transparent;color:inherit;font-size:1.8rem;cursor:pointer}.setting{padding:1.25rem 0;border-bottom:1px solid var(--soft-line)}.setting label{display:flex;justify-content:space-between;gap:1rem;margin-bottom:.75rem}.setting output{color:var(--muted-ink);font:500 .75rem var(--font-sans)}input[type='range']{width:100%;accent-color:var(--accent)}.check{min-height:52px;display:flex;align-items:center;gap:.75rem;border-bottom:1px solid var(--soft-line);cursor:pointer}.check input{width:18px;height:18px;accent-color:var(--accent)}.settings-panel footer{display:flex;justify-content:space-between;gap:1rem;padding-top:1.5rem}.settings-panel footer button{min-height:44px;padding:.5rem .9rem;border:1px solid var(--ink);background:transparent;color:inherit;cursor:pointer}.settings-panel footer .apply{background:var(--ink);color:var(--paper)}
</style>
