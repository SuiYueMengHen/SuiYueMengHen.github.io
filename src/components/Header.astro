---
import { siteConfig } from '../config/site';
import PrismLogo from './PrismLogo.astro';
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${siteConfig.name}首页`}>
      <PrismLogo size={38} />
      <span><b>{siteConfig.name}</b><small>{siteConfig.englishName}</small></span>
    </a>
    <nav id="site-nav" aria-label="主导航">
      {siteConfig.nav.map((item) => <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>)}
      <a href="/search/">搜索</a>
    </nav>
    <div class="header-actions">
      <button id="settings-toggle" class="icon-button" type="button" aria-label="打开阅读设置" aria-controls="reading-settings" title="阅读设置"><svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><path d="M4 7h10m4 0h2M4 17h2m4 0h10M14 4v6M7 14v6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></button>
      <button id="theme-toggle" class="icon-button" type="button" aria-label="切换明暗主题" title="切换明暗主题"><span aria-hidden="true">◐</span></button>
      <button id="menu-toggle" class="icon-button menu-button" type="button" aria-label="打开菜单" aria-controls="site-nav" aria-expanded="false"><span aria-hidden="true">≡</span></button>
    </div>
  </div>
</header>
<script>
  const themeButton=document.querySelector<HTMLButtonElement>('#theme-toggle');
  themeButton?.addEventListener('click',()=>{const next=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=next;localStorage.setItem('prism-theme',next);window.dispatchEvent(new CustomEvent('prism-theme-change',{detail:{theme:next}}))});
  const menuButton=document.querySelector<HTMLButtonElement>('#menu-toggle');const nav=document.querySelector<HTMLElement>('#site-nav');
  menuButton?.addEventListener('click',()=>{const open=menuButton.getAttribute('aria-expanded')==='true';menuButton.setAttribute('aria-expanded',String(!open));menuButton.setAttribute('aria-label',open?'打开菜单':'关闭菜单');nav?.classList.toggle('is-open',!open)});
</script>
<style>
  .site-header{position:sticky;top:0;z-index:100;border-bottom:1px solid var(--soft-line);background:color-mix(in srgb,var(--paper) 94%,transparent);backdrop-filter:blur(10px)}
  .header-inner{min-height:66px;display:flex;align-items:center;justify-content:space-between;gap:1rem}.brand{display:flex;align-items:center;gap:.7rem;text-decoration:none;line-height:1}.brand>span:last-child{display:grid;gap:.25rem}.brand b{font-weight:500}.brand small{font:500 .62rem var(--font-sans);letter-spacing:.1em;text-transform:uppercase;color:var(--muted-ink)}
  nav{display:flex;align-items:center;gap:1.35rem}nav a{min-height:44px;display:grid;place-items:center;font:500 .82rem var(--font-sans);text-decoration:none;position:relative}nav a[aria-current='page']::after{content:'';position:absolute;left:0;right:0;bottom:7px;border-top:1px solid currentColor}
  .header-actions{display:flex}.icon-button{width:44px;height:44px;display:grid;place-items:center;border:0;background:transparent;color:inherit;cursor:pointer;font-size:1.25rem}.icon-button:hover{color:var(--accent)}.menu-button{display:none}
  @media(max-width:760px){.menu-button{display:grid}nav{display:none;position:absolute;left:0;right:0;top:66px;padding:1rem 1.25rem 1.5rem;flex-direction:column;align-items:stretch;background:var(--paper);border-bottom:1px solid var(--line-color)}nav.is-open{display:flex}nav a{font-size:1rem}}
</style>
