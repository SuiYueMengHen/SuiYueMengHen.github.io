---
import { siteConfig } from '../config/site';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const active = (href: string) =>
  href === '/'
    ? path === '/'
    : href === '/blog/'
      ? /^\/(blog|tags|archive|search)(\/|$)/.test(path)
      : path.startsWith(href);
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${siteConfig.name} 首页`}>
      {siteConfig.name}
    </a>
    <nav id="site-nav" aria-label="主导航">
      {siteConfig.nav.map((item) => (
        <a
          href={item.href}
          aria-current={active(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <button
        id="theme-toggle"
        class="icon-button"
        type="button"
        aria-label="切换明暗主题"
        title="切换明暗主题"
      >
        <span class="sun">
          <Icon name="sun" />
        </span>
        <span class="moon">
          <Icon name="moon" />
        </span>
      </button>
      <button
        id="menu-toggle"
        class="icon-button menu-button"
        type="button"
        aria-label="打开菜单"
        aria-controls="site-nav"
        aria-expanded="false"
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>
<script>
  const root = document.documentElement;
  const notifyTheme = () => {
    const theme = root.dataset.theme;
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', theme === 'dark' ? '#1d1e20' : '#ffffff');
    document
      .querySelector('#theme-toggle')
      ?.setAttribute('aria-pressed', String(theme === 'dark'));
    dispatchEvent(new CustomEvent('prism-theme-change', { detail: { theme } }));
  };
  document.querySelector('#theme-toggle')?.addEventListener('click', () => {
    root.classList.add('theme-changing');
    window.setTimeout(() => root.classList.remove('theme-changing'), 260);
    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem('prism-theme', root.dataset.theme);
    } catch {}
    notifyTheme();
  });
  notifyTheme();
  matchMedia('(prefers-color-scheme: dark)').addEventListener(
    'change',
    (event) => {
      let saved;
      try {
        saved = localStorage.getItem('prism-theme');
      } catch {}
      if (saved !== 'light' && saved !== 'dark') {
        root.dataset.theme = event.matches ? 'dark' : 'light';
        notifyTheme();
      }
    },
  );
  const menu = document.querySelector<HTMLButtonElement>('#menu-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  function closeMenu() {
    menu?.setAttribute('aria-expanded', 'false');
    menu?.setAttribute('aria-label', '打开菜单');
    nav?.classList.remove('is-open');
  }
  menu?.addEventListener('click', () => {
    const open = menu.getAttribute('aria-expanded') !== 'true';
    menu.setAttribute('aria-expanded', String(open));
    menu.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
    nav?.classList.toggle('is-open', open);
  });
  document.addEventListener('keydown', (event) => {
    if (
      event.key === 'Escape' &&
      menu?.getAttribute('aria-expanded') === 'true'
    ) {
      closeMenu();
      menu.focus();
    }
  });
  nav?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) closeMenu();
  });
  matchMedia('(min-width: 761px)').addEventListener('change', (event) => {
    if (event.matches) closeMenu();
  });
</script>
<style>
  .site-header {
    position: relative;
    z-index: 100;
    background: var(--paper);
  }
  .header-inner {
    min-height: 88px;
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .brand {
    font-size: 1.4rem;
    font-weight: 750;
    letter-spacing: -0.035em;
    text-decoration: none;
    margin-right: auto;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1.8rem;
  }
  nav a {
    min-height: 44px;
    display: grid;
    place-items: center;
    font-size: 0.95rem;
    text-decoration: none;
    position: relative;
    white-space: nowrap;
  }
  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 3px;
    border-top: 2px solid var(--muted-ink);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.2s ease;
  }
  nav a:hover::after,
  nav a:focus-visible::after,
  nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  nav a {
    transition:
      color 0.18s ease,
      transform 0.18s ease;
  }
  nav a:hover {
    transform: translateY(-1px);
  }
  .header-actions {
    display: flex;
    gap: 0.25rem;
  }
  .icon-button {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--ink);
    transition:
      background 0.18s ease,
      transform 0.18s ease;
  }
  .icon-button:hover {
    background: var(--surface);
  }
  .sun,
  .moon {
    grid-area: 1 / 1;
    transition:
      opacity 0.22s ease,
      transform 0.22s ease;
  }
  .sun {
    opacity: 0;
    transform: rotate(-65deg) scale(0.65);
  }
  .moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  :global([data-theme='dark']) .sun {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  :global([data-theme='dark']) .moon {
    opacity: 0;
    transform: rotate(65deg) scale(0.65);
  }
  .icon-button:active {
    transform: scale(0.92);
  }
  .menu-button {
    display: none;
  }
  @media (max-width: 760px) {
    .header-inner {
      min-height: 76px;
      gap: 0.5rem;
    }
    .brand {
      font-size: 1.15rem;
    }
    .menu-button {
      display: grid;
    }
    nav {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 76px;
      padding: 1rem 1rem 1.5rem;
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
      background: var(--paper);
      border-bottom: 1px solid var(--line-color);
    }
    nav.is-open {
      display: flex;
      animation: menu-enter 0.18s ease both;
    }
    nav a {
      justify-items: start;
      padding-inline: 1rem;
    }
    nav a::after {
      left: 1rem;
      right: auto;
      width: 2rem;
    }
  }
  @keyframes menu-enter {
    from {
      opacity: 0;
      transform: translateY(-5px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
