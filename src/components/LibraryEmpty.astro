---
interface Props { index: string; title: string; description: string; note?: string; }
const { index, title, description, note = 'Prism Notes · open volume' } = Astro.props;
---
<section class="empty-library" aria-label={title}>
  <div class="empty-mark" aria-hidden="true"><span></span><span></span><i></i></div>
  <div class="empty-copy"><p>{index}</p><h2>{title}</h2><p>{description}</p></div>
  <p class="empty-note">{note}</p>
</section>
<style>
  .empty-library{position:relative;min-height:24rem;display:grid;grid-template-columns:minmax(10rem,1fr) minmax(0,1.5fr);align-items:center;gap:clamp(2rem,7vw,7rem);padding:clamp(2.4rem,6vw,5rem);overflow:hidden;border:1px solid var(--line-color);background:linear-gradient(135deg,color-mix(in srgb,var(--ink) 2.5%,var(--paper)),var(--paper) 58%)}
  .empty-library::before{content:'';position:absolute;inset:1rem;border:1px solid var(--soft-line);pointer-events:none}.empty-mark{position:relative;aspect-ratio:1;max-width:15rem;justify-self:center}.empty-mark span{position:absolute;inset:14%;border:1px solid var(--ink);border-radius:50%;transform:rotate(34deg) scaleY(.34)}.empty-mark span:nth-child(2){transform:rotate(-34deg) scaleY(.34)}.empty-mark i{position:absolute;left:50%;top:10%;height:80%;border-left:1px solid var(--accent);transform:rotate(18deg)}
  .empty-copy{position:relative;z-index:1;max-width:34rem}.empty-copy>p:first-child,.empty-note{font:500 .66rem/1.4 var(--font-sans);letter-spacing:.13em;text-transform:uppercase;color:var(--muted-ink)}.empty-copy h2{margin:.6rem 0 1rem;font-size:clamp(2rem,5vw,3.6rem);font-weight:500;line-height:1.06;letter-spacing:-.035em}.empty-copy>p:last-child{margin:0;color:var(--muted-ink)}.empty-note{position:absolute;right:1.5rem;bottom:1.25rem;margin:0}
  @media(max-width:680px){.empty-library{min-height:28rem;grid-template-columns:1fr;text-align:center}.empty-mark{width:9rem}.empty-copy{justify-self:center}.empty-note{position:relative;right:auto;bottom:auto;grid-column:1;margin:0}}
</style>
