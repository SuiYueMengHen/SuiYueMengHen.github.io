---
import type { BlogPost } from '../lib/posts';
import { formatDate, postSlug, readingMinutes } from '../lib/posts';
interface Props { post: BlogPost; index?: number; featured?: boolean; }
const { post, index = 0, featured = false } = Astro.props;
const slug = postSlug(post);
---
<article class:list={['post-card', { featured }]}>
  <div class="number" aria-hidden="true">{String(index + 1).padStart(2,'0')}.</div>
  <div class="card-content">
    <div class="meta"><time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time><span>·</span><a href={`/categories/${encodeURIComponent(post.data.category)}/`}>{post.data.category}</a><span>·</span><span>{readingMinutes(post.body)} 分钟</span></div>
    <h3><a href={`/blog/${slug}/`}>{post.data.title}</a></h3>
    <p>{post.data.description}</p>
    <div class="card-foot"><div>{post.data.tags.slice(0,3).map((tag)=><a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}</div><a class="read" href={`/blog/${slug}/`}>阅读全文&nbsp;→</a></div>
  </div>
</article>
<style>
  .post-card{display:grid;grid-template-columns:2.3rem 1fr;gap:1rem;padding:1.8rem 0;border-top:1px solid var(--soft-line)}.post-card:last-child{border-bottom:1px solid var(--soft-line)}.number{padding-top:.22rem;font-style:italic;color:var(--muted-ink)}.meta{display:flex;flex-wrap:wrap;gap:.35rem .65rem;color:var(--muted-ink);font:500 .76rem var(--font-sans)}.meta a{text-decoration:none}.post-card h3{margin:.55rem 0 .65rem;font-size:clamp(1.45rem,3vw,2rem);font-weight:500;line-height:1.2}.post-card h3 a{text-decoration:none}.post-card p{max-width:42rem;margin:.6rem 0;color:var(--muted-ink)}.card-foot{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin-top:1rem;font:500 .76rem var(--font-sans)}.card-foot>div{display:flex;flex-wrap:wrap;gap:.7rem}.card-foot a{text-decoration:none}.read{white-space:nowrap}.featured{grid-template-columns:3rem 1fr;padding-block:2.2rem}.featured h3{font-size:clamp(2rem,5vw,3rem)}
  @media(max-width:520px){.post-card,.featured{grid-template-columns:1fr}.number{display:none}.card-foot{align-items:flex-start;flex-direction:column}}
</style>
