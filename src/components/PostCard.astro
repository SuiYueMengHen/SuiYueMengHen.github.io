---
import type { BlogPost } from '../lib/posts';
import { formatDate, postSlug, readingMinutes } from '../lib/posts';
interface Props { post: BlogPost; index?: number; featured?: boolean; }
const { post, index = 0, featured = false } = Astro.props;
const slug = postSlug(post);
---
<article class:list={['post-card', { featured }]}>
  <a class="visual" href={`/blog/${slug}/`} aria-label={`阅读《${post.data.title}》`}>
    {post.data.cover ? <img src={post.data.cover.src} width={post.data.cover.width} height={post.data.cover.height} alt={post.data.coverAlt || ''} loading={featured ? 'eager' : 'lazy'} /> : <div class={`abstract abstract-${index % 4}`} aria-hidden="true"><span></span><i></i><b></b></div>}
    <span class="card-index">{String(index + 1).padStart(2, '0')}</span>
  </a>
  <div class="card-content">
    <div class="meta"><a href={`/categories/${encodeURIComponent(post.data.category)}/`}>{post.data.category}</a><span>{formatDate(post.data.publishDate)}</span><span>{readingMinutes(post.body)} 分钟</span></div>
    <h3><a href={`/blog/${slug}/`}>{post.data.title}</a></h3>
    <p>{post.data.description}</p>
    <div class="card-foot"><div>{post.data.tags.slice(0, 3).map((tag) => <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}</div><a class="arrow" href={`/blog/${slug}/`} aria-label={`阅读《${post.data.title}》`}><span aria-hidden="true">↗</span></a></div>
  </div>
</article>
<style>
  .post-card { min-width: 0; border: var(--line); background: var(--surface); transition: transform .25s ease, box-shadow .25s ease; }.post-card:hover { transform: translate(-5px,-5px); box-shadow: 8px 8px 0 var(--ink); }.visual { position: relative; display: block; aspect-ratio: 16/10; overflow: hidden; border-bottom: var(--line); }.visual img { width: 100%; height: 100%; object-fit: cover; }.card-index { position: absolute; top: .75rem; right: .75rem; display: grid; place-items: center; width: 40px; height: 40px; background: var(--ink); color: var(--paper); font: .72rem var(--font-mono); }.abstract { width: 100%; height: 100%; position: relative; overflow: hidden; background: var(--yellow); }.abstract span,.abstract i,.abstract b { position: absolute; display: block; }.abstract-0 span { width: 55%; aspect-ratio: 1; border: 20px solid var(--blue); border-radius: 50%; left: -8%; top: -22%; }.abstract-0 i { inset: 20% 12% 5% 42%; background: var(--red); clip-path: polygon(50% 0,100% 100%,0 100%); }.abstract-0 b { width: 42%; height: 12%; background: var(--ink); right: 3%; bottom: 8%; transform: rotate(-18deg); }.abstract-1 { background: var(--blue); }.abstract-1 span { inset: -12% 30% 5% 15%; border: 18px solid #fff; transform: rotate(25deg); }.abstract-1 i { width: 45%; aspect-ratio: 1; border-radius: 50%; background: var(--red); right: -10%; bottom: -25%; }.abstract-1 b { width: 4px; height: 120%; background: var(--yellow); left: 60%; top: -10%; transform: rotate(35deg); }.abstract-2 { background: var(--red); }.abstract-2 span { inset: 12%; background: var(--surface); clip-path: polygon(0 0,100% 0,0 100%); }.abstract-2 i { width: 35%; aspect-ratio: 1; border: 16px solid var(--ink); border-radius: 50%; right: 6%; bottom: 5%; }.abstract-2 b { width: 50%; height: 8%; background: var(--blue); left: 8%; top: 18%; }.abstract-3 { background: var(--ink); }.abstract-3 span { width: 60%; aspect-ratio: 1; border: 16px solid var(--yellow); transform: rotate(45deg); left: 12%; top: -5%; }.abstract-3 i { width: 45%; aspect-ratio: 1; background: var(--blue); border-radius: 50%; right: -5%; bottom: -12%; }.abstract-3 b { width: 20%; height: 70%; background: var(--red); left: 8%; bottom: -10%; transform: rotate(-30deg); }.card-content { padding: clamp(1.25rem,3vw,2rem); }.meta { display: flex; flex-wrap: wrap; gap: .5rem 1rem; font: .68rem var(--font-mono); text-transform: uppercase; color: var(--muted-ink); }.meta a { color: var(--ink); font-weight: 750; }.post-card h3 { margin: 1.25rem 0 .8rem; font-size: clamp(1.5rem, 3vw, 2.3rem); line-height: 1.08; letter-spacing: -.035em; }.post-card h3 a { text-decoration: none; }.post-card p { color: var(--muted-ink); }.card-foot { margin-top: 1.75rem; padding-top: 1rem; border-top: var(--line); display: flex; justify-content: space-between; align-items: end; gap: 1rem; }.card-foot > div { display: flex; flex-wrap: wrap; gap: .4rem; }.arrow { width: 48px; height: 48px; flex: 0 0 auto; display: grid; place-items: center; border-radius: 50%; border: 2px solid var(--ink); font-size: 1.4rem; text-decoration: none; transition: background .2s,color .2s,transform .2s; }.arrow:hover { background: var(--ink); color: var(--paper); transform: rotate(45deg); }.featured { display: grid; grid-template-columns: 7fr 5fr; }.featured .visual { aspect-ratio: auto; border-bottom: 0; border-right: var(--line); }.featured h3 { font-size: clamp(2.2rem,5vw,4.5rem); }
  @media(max-width:760px){ .featured { grid-template-columns:1fr; }.featured .visual { aspect-ratio:16/10; border-right:0; border-bottom:var(--line); } }
</style>
