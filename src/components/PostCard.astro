---
import { Image } from 'astro:assets';
import type { BlogPost } from '../lib/posts';
import { formatDate, postSlug } from '../lib/posts';
interface Props {
  post: BlogPost;
}
const { post } = Astro.props;
const href = `/blog/${postSlug(post)}/`;
---

<article class="post-card">
  {post.data.cover && (
    <a class="post-cover" href={href} tabindex="-1" aria-hidden="true">
      <Image
        src={post.data.cover}
        alt={post.data.coverAlt || ''}
        widths={[640, 960]}
        sizes="(max-width: 760px) 100vw, 720px"
        loading="lazy"
      />
    </a>
  )}
  <h2>
    <a href={href}>{post.data.title}</a>
  </h2>
  {post.data.description && <p>{post.data.description}</p>}
  <div class="post-meta">
    <time datetime={post.data.publishDate.toISOString()}>
      {formatDate(post.data.publishDate)}
    </time>
    {post.data.draft && <span>草稿</span>}
    {post.data.tags.map((tag) => (
      <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
    ))}
  </div>
</article>
<style>
  .post-card {
    padding: 2rem 0;
    border-bottom: 1px solid var(--soft-line);
  }
  .post-cover {
    display: block;
    margin-bottom: 1.5rem;
    border-radius: 6px;
    overflow: hidden;
  }
  .post-cover :global(img) {
    width: 100%;
    aspect-ratio: 16 / 7;
    object-fit: cover;
  }
  h2 {
    font-size: 1.45rem;
    margin: 0;
    font-weight: 650;
    overflow-wrap: anywhere;
  }
  h2 a {
    text-decoration: none;
  }
  p {
    margin: 0.75rem 0 0;
    color: var(--muted-ink);
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 1rem;
    color: var(--muted-ink);
    font-size: 0.8rem;
  }
  .post-meta a {
    text-decoration: none;
  }
</style>
