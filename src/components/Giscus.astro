---
import { siteConfig } from '../config/site';
const ready = siteConfig.comments.enabled && siteConfig.comments.repoId && siteConfig.comments.categoryId;
---
<section class="comments" aria-labelledby="comments-title">
  <h2 id="comments-title">回应与讨论</h2>
  {ready ? <script is:inline src="https://giscus.app/client.js" data-repo={siteConfig.comments.repo} data-repo-id={siteConfig.comments.repoId} data-category={siteConfig.comments.category} data-category-id={siteConfig.comments.categoryId} data-mapping="pathname" data-strict="0" data-reactions-enabled="1" data-emit-metadata="0" data-input-position="top" data-theme={siteConfig.comments.themes.light} data-lang="zh-CN" crossorigin="anonymous" async></script> : <div class="comments-pending"><p>评论功能将在 GitHub Discussions 完成初始化后自动开启。</p><a href={`${siteConfig.author.github}/${siteConfig.comments.repo.split('/')[1]}/discussions`}>前往 GitHub 参与讨论 ↗</a></div>}
</section>
<script is:inline define:vars={{ lightTheme: siteConfig.comments.themes.light, darkTheme: siteConfig.comments.themes.dark }}>
  const comments=document.querySelector('.comments');
  const syncGiscusTheme=()=>{const iframe=document.querySelector('.giscus-frame');const theme=document.documentElement.dataset.theme==='dark'?darkTheme:lightTheme;iframe?.contentWindow?.postMessage({giscus:{setConfig:{theme}}},'https://giscus.app')};
  const observer=new MutationObserver(()=>{const iframe=document.querySelector('.giscus-frame');if(iframe){iframe.addEventListener('load',syncGiscusTheme,{once:true});syncGiscusTheme();observer.disconnect()}});if(comments)observer.observe(comments,{childList:true,subtree:true});window.addEventListener('prism-theme-change',syncGiscusTheme);
</script>
<style>.comments{max-width:var(--measure);margin:5rem auto 0;padding-top:2.5rem;border-top:1px solid var(--line-color)}.comments h2{font-size:1.6rem;font-weight:500}.comments h2::before{content:'§ ';color:var(--accent)}.comments-pending{padding:1.5rem;border:1px solid var(--soft-line);background:var(--surface)}.comments-pending p{margin-top:0}</style>
