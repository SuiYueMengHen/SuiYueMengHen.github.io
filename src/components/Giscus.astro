---
import { siteConfig } from '../config/site';
const ready = siteConfig.comments.enabled && siteConfig.comments.repoId && siteConfig.comments.categoryId;
const discussionsUrl = `${siteConfig.author.github}/${siteConfig.comments.repo.split('/')[1]}/discussions`;
---
<section class="comments" aria-labelledby="comments-title">
  <header class="comments-head">
    <div class="comments-index" aria-hidden="true"><span>R</span><small>esponse</small></div>
    <div class="comments-intro">
      <p class="comments-kicker">Dialogue / 讨论</p>
      <h2 id="comments-title">回应与讨论</h2>
      <p>留下你的补充、疑问或不同观点。讨论公开保存于 GitHub，也会成为文章的延伸注脚。</p>
    </div>
    <a class="comments-external" href={discussionsUrl} target="_blank" rel="noreferrer">查看全部讨论 <span aria-hidden="true">↗</span></a>
  </header>
  <div class="comments-frame">
    <div class="comments-meta" aria-hidden="true"><span>GitHub Discussions</span><span>Public correspondence</span></div>
    <div class="giscus-slot">
      {ready ? <script is:inline src="https://giscus.app/client.js" data-repo={siteConfig.comments.repo} data-repo-id={siteConfig.comments.repoId} data-category={siteConfig.comments.category} data-category-id={siteConfig.comments.categoryId} data-mapping="pathname" data-strict="0" data-reactions-enabled="1" data-emit-metadata="0" data-input-position="top" data-theme={siteConfig.comments.themes.light} data-lang="zh-CN" crossorigin="anonymous" async></script> : <div class="comments-pending"><p>评论功能将在 GitHub Discussions 完成初始化后自动开启。</p><a href={discussionsUrl}>前往 GitHub 参与讨论 ↗</a></div>}
    </div>
  </div>
</section>
<script is:inline define:vars={{ lightTheme: siteConfig.comments.themes.light, darkTheme: siteConfig.comments.themes.dark }}>
  const comments=document.querySelector('.comments');
  const syncGiscusTheme=()=>{const iframe=document.querySelector('.giscus-frame');const theme=document.documentElement.dataset.theme==='dark'?darkTheme:lightTheme;iframe?.contentWindow?.postMessage({giscus:{setConfig:{theme}}},'https://giscus.app')};
  const observer=new MutationObserver(()=>{const iframe=document.querySelector('.giscus-frame');if(iframe){iframe.addEventListener('load',syncGiscusTheme,{once:true});syncGiscusTheme();observer.disconnect()}});if(comments)observer.observe(comments,{childList:true,subtree:true});window.addEventListener('prism-theme-change',syncGiscusTheme);
</script>
<style>
  .comments{max-width:var(--measure);margin:clamp(5rem,10vw,8rem) auto 0;padding-bottom:clamp(4rem,8vw,7rem)}
  .comments-head{display:grid;grid-template-columns:4.5rem 1fr auto;gap:clamp(1rem,3vw,2rem);align-items:start;padding:2rem 0;border-top:1px solid var(--ink)}
  .comments-index{display:flex;align-items:baseline;color:var(--muted-ink);font-family:var(--font-sans);line-height:1}.comments-index span{font-family:var(--font-serif);font-size:2.7rem;color:var(--ink)}.comments-index small{font-size:.65rem;letter-spacing:.08em;text-transform:uppercase}
  .comments-kicker{margin:0 0 .35rem;font:500 .67rem var(--font-sans);letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}
  .comments h2{margin:0;font-size:clamp(1.9rem,4vw,2.7rem);font-weight:500;line-height:1.15}.comments-intro>p:last-child{max-width:34rem;margin:.8rem 0 0;color:var(--muted-ink);font-size:.95rem;line-height:1.75}
  .comments-external{display:inline-flex;min-height:44px;align-items:center;gap:.45rem;padding:.45rem 0;font:500 .75rem var(--font-sans);letter-spacing:.04em;text-decoration:none;white-space:nowrap;border-bottom:1px solid var(--ink)}
  .comments-frame{position:relative;padding:clamp(1rem,3vw,2rem);border:1px solid var(--line-color);background:var(--surface);box-shadow:inset 0 0 0 5px var(--paper),inset 0 0 0 6px var(--soft-line)}
  .comments-meta{display:flex;justify-content:space-between;gap:1rem;margin:0 0 1.5rem;padding:.25rem 0 .8rem;border-bottom:1px solid var(--soft-line);font:500 .65rem var(--font-sans);letter-spacing:.1em;text-transform:uppercase;color:var(--muted-ink)}
  .giscus-slot{min-height:7rem}.comments-pending,:global(.studio-comments-note){margin:0;padding:1.25rem;border:1px solid var(--soft-line);background:var(--paper)}.comments-pending p,:global(.studio-comments-note){margin-top:0;color:var(--muted-ink)}.comments-pending a{font-family:var(--font-sans)}
  @media(max-width:700px){.comments-head{grid-template-columns:3.2rem 1fr}.comments-index span{font-size:2.2rem}.comments-external{grid-column:2;justify-self:start}.comments-frame{padding:1rem}.comments-meta{align-items:flex-start;flex-direction:column;gap:.25rem}}
</style>
