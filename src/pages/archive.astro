---
import { getCollection } from 'astro:content';import BaseLayout from '../layouts/BaseLayout.astro';import LibraryEmpty from '../components/LibraryEmpty.astro';import { contentStats,formatDate,postSlug,visiblePosts } from '../lib/posts';const posts=visiblePosts(await getCollection('blog'));const groups=Object.entries(Object.groupBy(posts,(post)=>String(post.data.publishDate.getFullYear()))).sort(([a],[b])=>Number(b)-Number(a));
---
<BaseLayout title="文章归档"><header class="archive-head shell"><p class="section-kicker">Chronological bibliography</p><div><h1 class="display">归档</h1><p><strong>{posts.length}</strong> 篇文章<br/>按写作时间留下索引。</p></div></header><main class="archive shell">{groups.length?groups.map(([year,items],groupIndex)=><section><header><span>{String(groupIndex+1).padStart(2,'0')}</span><h2>{year}</h2><b>{items?.length||0} entries</b></header><ol>{items?.map((post,index)=>{const stats=contentStats(post.body);return <li><a href={`/blog/${postSlug(post)}/`}><em>{String(index+1).padStart(2,'0')}</em><time>{formatDate(post.data.publishDate)}</time><strong>{post.data.title}</strong><span>[{post.data.collection?'合集章节':post.data.category}] · {stats.words.toLocaleString('zh-CN')} 字 · 约 {stats.minutes} 分钟</span></a></li>})}</ol></section>):<LibraryEmpty index="Archive / 00" title="时间轴尚未启用" description="当第一篇文章发布后，它会依照日期被收录于此。归档只负责记录时间，不改变合集中的章节顺序。" note="Chronology begins with the first note" />}</main></BaseLayout>
<style>.archive-head{padding:clamp(4.5rem,10vw,8rem) 0 clamp(2.5rem,5vw,4rem);border-bottom:1px solid var(--ink)}.archive-head>div{display:grid;grid-template-columns:1fr auto;gap:2rem;align-items:end}.archive-head h1{margin:0}.archive-head>div p{margin:0;text-align:right;color:var(--muted-ink)}.archive-head strong{font:500 2.5rem var(--font-serif);color:var(--ink)}.archive{padding-block:2rem 7rem}.archive>section{display:grid;grid-template-columns:12rem 1fr;gap:clamp(1.5rem,5vw,5rem);padding:2rem 0;border-top:1px solid var(--line-color)}.archive>section>header{display:grid;grid-template-columns:auto 1fr;align-content:start;gap:.2rem .8rem}.archive>section>header span,.archive>section>header b{font:500 .65rem var(--font-sans);color:var(--muted-ink);text-transform:uppercase;letter-spacing:.1em}.archive h2{grid-column:2;margin:-.2rem 0 0;font-size:clamp(2.5rem,6vw,4.5rem);line-height:1;font-weight:500}.archive>section>header b{grid-column:2}.archive ol{margin:0;padding:0;list-style:none}.archive li{border-bottom:1px solid var(--soft-line)}.archive a{display:grid;grid-template-columns:2rem 7rem minmax(8rem,1fr) auto;gap:1rem;align-items:baseline;min-height:60px;padding:.9rem .2rem;text-decoration:none}.archive em,.archive time,.archive span{font:500 .7rem var(--font-sans);font-style:normal;color:var(--muted-ink)}.archive strong{font-weight:500}@media(max-width:760px){.archive-head>div{grid-template-columns:1fr}.archive-head>div p{text-align:left}.archive>section{grid-template-columns:1fr}.archive a{grid-template-columns:2rem 1fr}.archive time,.archive strong{grid-column:2}.archive span{display:none}}</style>
