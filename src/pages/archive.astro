---
import { getCollection } from 'astro:content';import BaseLayout from '../layouts/BaseLayout.astro';import { formatDate,postSlug,visiblePosts } from '../lib/posts';
const posts=visiblePosts(await getCollection('blog'));const groups=Object.entries(Object.groupBy(posts,(post)=>String(post.data.publishDate.getFullYear()))).sort(([a],[b])=>Number(b)-Number(a));
---
<BaseLayout title="文章归档"><header class="page-head shell"><p class="section-kicker">Chronological index</p><h1 class="display">归档</h1><p>{posts.length} 篇文章，沿着时间逆流而上。</p></header><section class="section"><div class="shell archive">{groups.map(([year,items])=><section><h2>{year}</h2><div>{items?.map((post)=><a href={`/blog/${postSlug(post)}/`}><time>{formatDate(post.data.publishDate)}</time><strong>{post.data.title}</strong><span>{post.data.category}</span></a>)}</div></section>)}</div></section></BaseLayout>
<style>.archive section{display:grid;grid-template-columns:3fr 9fr;border-top:var(--line)}.archive h2{margin:0;padding:1.5rem 0;font-size:clamp(3rem,8vw,7rem);line-height:1}.archive section>div a{display:grid;grid-template-columns:2fr 7fr 2fr;gap:1rem;padding:1.25rem 0;border-bottom:var(--line);text-decoration:none}.archive a:hover strong{color:var(--red)}.archive time,.archive span{font:.7rem var(--font-mono)}@media(max-width:700px){.archive section{grid-template-columns:1fr}.archive section>div a{grid-template-columns:1fr}.archive span{display:none}}</style>
