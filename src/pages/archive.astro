---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { visiblePosts } from '../lib/posts';
const posts = visiblePosts(await getCollection('blog'));
const years = [
  ...new Set(posts.map((post) => post.data.publishDate.getUTCFullYear())),
];
---

<BaseLayout title="归档" description="按时间浏览全部个人笔记。">
  <header class="page-head shell">
    <p class="section-kicker">Archive · {posts.length} 篇文章</p>
    <h1 class="display">归档</h1>
    <p>每一篇笔记，都是思考留下的痕迹。</p>
  </header>
  <div class="archive shell">
    {years.map((year) => (
      <section>
        <h2>{year}</h2>
        {posts
          .filter((post) => post.data.publishDate.getUTCFullYear() === year)
          .map((post) => (
            <PostCard post={post} />
          ))}
      </section>
    ))}
    {!posts.length && (
      <div class="empty-state">
        <h2>还没有发布的笔记</h2>
        <p>第一篇文章发布后，会出现在这里。</p>
      </div>
    )}
  </div>
</BaseLayout>
<style>
  .archive {
    padding-bottom: 4rem;
  }
  .archive section {
    margin-bottom: 2.5rem;
  }
  .archive h2 {
    font-size: 1.35rem;
    font-weight: 650;
    border-bottom: 1px solid var(--line-color);
    padding-bottom: 1rem;
    margin-bottom: 0;
  }
</style>
