---
import { getCollection } from 'astro:content';import BaseLayout from '../layouts/BaseLayout.astro';import { contentStats,formatDate,postSlug,visiblePosts } from '../lib/posts';const posts=visiblePosts(await getCollection('blog'));const groups=Object.entries(Object.groupBy(posts,(post)=>String(post.data.publishDate.getFullYear()))).sort(([a],[b])=>Number(b)-Number(a));
---
<BaseLayout title="文章归档"><header class="page-head shell"><p class="section-kicker">Chronological bibliography</p><h1 class="display">归档</h1><p>共 {posts.length} 篇文章，按年份编排。</p></header><section class="section"><div class="shell archive">{groups.map(([year,items])=><section><h2>{year}</h2><ol>{items?.map((post)=>{const stats=contentStats(post.body);return <li><a href={`/blog/${postSlug(post)}/`}><time>{formatDate(post.data.publishDate)}</time><strong>{post.data.title}</strong><span>[{post.data.category}] · {stats.words.toLocaleString('zh-CN')} 字 · 约 {stats.minutes} 分钟</span></a></li>})}</ol></section>)}</div></section></BaseLayout>
<style>.archive{max-width:var(--measure)}.archive section{margin-bottom:3rem}.archive h2{margin:0 0 1rem;padding-bottom:.45rem;border-bottom:1px solid var(--ink);font-size:1.7rem;font-weight:500}.archive ol{margin:0;padding-left:2rem}.archive li{padding-left:.6rem;border-bottom:1px solid var(--soft-line)}.archive a{display:grid;grid-template-columns:8rem 1fr auto;gap:1rem;align-items:baseline;min-height:56px;padding:.8rem 0;text-decoration:none}.archive time,.archive span{font:500 .72rem var(--font-sans);color:var(--muted-ink)}.archive strong{font-weight:500}@media(max-width:620px){.archive a{grid-template-columns:1fr}.archive span{display:none}}</style>
