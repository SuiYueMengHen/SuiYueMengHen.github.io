---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { sortedProjects } from '../../lib/posts';
const projects = sortedProjects(await getCollection('projects'));
const languages = [
  ...new Set(projects.map((project) => project.data.language).filter(Boolean)),
] as string[];
---

<BaseLayout
  title="Projects"
  description="一些持续打磨的开源项目：应用、科学计算与排版工具。"
>
  <header class="page-head shell">
    <h1 class="display">Projects</h1>
    <p>一些持续打磨的开源项目。</p>
  </header>
  <div class="shell projects-page">
    <div class="filter-bar" role="group" aria-label="按项目语言筛选">
      <button type="button" data-project-filter="" aria-pressed="true">
        全部
      </button>
      {languages.map((language) => (
        <button
          type="button"
          data-project-filter={language}
          aria-pressed="false"
        >
          {language}
        </button>
      ))}
    </div>
    <p class="sr-only" id="project-status" role="status" aria-live="polite">
      {projects.length} 个项目
    </p>
    <section class="projects" aria-label="项目列表">
      {projects.map((project) => (
        <div
          class="project-item"
          data-project-language={project.data.language || ''}
        >
          <ProjectCard project={project} />
        </div>
      ))}
    </section>
    {!projects.length && (
      <div class="empty-state">
        <h2>项目正在整理中</h2>
        <p>新的开源项目会陆续收录于此。</p>
      </div>
    )}
    <p class="project-note">
      更多探索，见{' '}
      <a href="https://github.com/SuiYueMengHen?tab=repositories">GitHub →</a>
    </p>
  </div>
</BaseLayout>
<script>
  // Delegation also works when Prism Studio replaces the project snapshot.
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
      '[data-project-filter]',
    );
    if (!button) return;
    const filters = [
      ...document.querySelectorAll<HTMLButtonElement>('[data-project-filter]'),
    ];
    const items = [
      ...document.querySelectorAll<HTMLElement>('[data-project-language]'),
    ];
    filters.forEach((filter) =>
      filter.setAttribute('aria-pressed', String(filter === button)),
    );
    const language = button.dataset.projectFilter;
    items.forEach((item) => {
      item.hidden = !!language && item.dataset.projectLanguage !== language;
    });
    const status = document.querySelector('#project-status');
    if (status)
      status.textContent = `${items.filter((item) => !item.hidden).length} 个项目`;
  });
</script>
<style>
  .projects-page {
    padding-bottom: 3rem;
  }
  .filter-bar {
    margin-top: 0;
  }
  .projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .project-item {
    display: grid;
    min-width: 0;
  }
  .project-note {
    margin: 2.5rem 0 0;
    font-size: 0.85rem;
    color: var(--muted-ink);
    text-align: center;
  }
  @media (max-width: 640px) {
    .projects {
      grid-template-columns: 1fr;
    }
  }
</style>
