---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PrismHero from '../components/PrismHero.astro';
import PostCard from '../components/PostCard.astro';
import { visiblePosts } from '../lib/posts';
import { siteConfig } from '../config/site';
const posts = visiblePosts(await getCollection('blog'));
const featured = posts.find((post) => post.data.featured) || posts[0];
const latest = posts.filter((post) => post.id !== featured?.id).slice(0, 4);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].slice(0, 10);
---
<BaseLayout>
  <PrismHero />
  {featured && <section class="section"><div class="shell"><p class="section-kicker">Featured reflection</p><h2 class="section-heading">本期折射</h2><PostCard post={featured} featured /></div></section>}
  <section class="section latest"><div class="shell"><div class="section-title-row"><div><p class="section-kicker">Latest notes</p><h2 class="section-heading">最近写下</h2></div><a class="button button--ghost" href="/blog/">查看全部文章</a></div><div class="posts-grid">{latest.map((post, index) => <PostCard post={post} index={index + 1} />)}</div></div></section>
  <section class="manifesto"><div class="shell grid-12"><p class="section-kicker">Writing manifesto</p><blockquote>“写作不是给答案，<br /><em>而是校准观看世界的角度。</em>”</blockquote><p>这里收集未经速食化的思考：技术背后的人、创造发生的过程，以及普通日子里值得留住的细节。</p></div></section>
  <section class="section"><div class="shell grid-12"><div class="topics-copy"><p class="section-kicker">Explore spectrum</p><h2 class="section-heading">沿着主题<br />继续探索</h2></div><div class="tag-cloud">{tags.map((tag, index) => <a href={`/tags/${encodeURIComponent(tag)}/`} style={`--i:${index}`}>#{tag}<span>{String(index + 1).padStart(2,'0')}</span></a>)}</div></div></section>
  <section class="author-strip"><div class="shell grid-12"><div class="avatar" aria-hidden="true"><span>S</span><i>M</i><b>H</b></div><div><p class="section-kicker">About the author</p><h2>{siteConfig.author.name}</h2><p>{siteConfig.author.bio} 以长期主义维护这片小小的数字花园。</p><a class="button button--ghost" href="/about/">更多关于我</a></div></div></section>
</BaseLayout>
<style>
  .section-title-row { display:flex; justify-content:space-between; align-items:end; gap:2rem; }.posts-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:2rem; }.manifesto { padding-block:clamp(5rem,12vw,11rem); background:var(--blue); color:#fff; }.manifesto .section-kicker { grid-column:1/4; align-self:start; }.manifesto .section-kicker::before { border-color:var(--yellow); }.manifesto blockquote { grid-column:4/12; margin:0; font-size:clamp(2.5rem,6.5vw,6.5rem); line-height:1; letter-spacing:-.055em; font-weight:800; }.manifesto blockquote em { color:var(--yellow); font-style:normal; }.manifesto .grid-12>p:last-child { grid-column:8/12; margin-top:2rem; }.topics-copy { grid-column:1/7; }.tag-cloud { grid-column:7/13; display:flex; flex-direction:column; border-top:var(--line); }.tag-cloud a { display:flex; justify-content:space-between; padding:1rem 0; border-bottom:var(--line); font-size:clamp(1.2rem,2.7vw,2.3rem); font-weight:750; text-decoration:none; transition:padding .2s,color .2s; }.tag-cloud a:hover { padding-left:1rem; color:var(--red); }.tag-cloud span { font: .7rem var(--font-mono); }.author-strip { padding-block:clamp(4rem,9vw,8rem); border-top:var(--line); background:var(--surface); }.author-strip .avatar { grid-column:1/6; aspect-ratio:1; position:relative; display:grid; place-items:center; border:3px solid var(--ink); background:var(--yellow); overflow:hidden; font-size:clamp(7rem,20vw,16rem); font-weight:900; line-height:1; }.avatar i,.avatar b { position:absolute; font-style:normal; }.avatar i { color:var(--blue); left:-2%; top:18%; mix-blend-mode:multiply; }.avatar b { color:var(--red); right:-2%; bottom:-12%; mix-blend-mode:multiply; }.author-strip .grid-12>div:last-child { grid-column:7/13; align-self:center; }.author-strip h2 { margin:.5rem 0; font-size:clamp(3rem,7vw,6rem); letter-spacing:-.06em; }.author-strip p:not(.section-kicker) { max-width:34rem; font-size:1.15rem; margin-bottom:2rem; }
  @media(max-width:760px){ .section-title-row{align-items:start;flex-direction:column}.posts-grid{grid-template-columns:1fr}.manifesto .section-kicker,.manifesto blockquote,.manifesto .grid-12>p:last-child,.topics-copy,.tag-cloud,.author-strip .avatar,.author-strip .grid-12>div:last-child{grid-column:auto}.manifesto blockquote{font-size:clamp(2.7rem,12vw,4rem)} }
</style>
