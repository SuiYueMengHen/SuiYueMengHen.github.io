---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import categoryRegistry from '../../data/categories.json';
import { categoryPosts, visiblePosts } from '../../lib/posts';
import { categoryPreviewVersion } from '../../lib/preview-version';
const posts = visiblePosts(await getCollection('blog'));
const names = [
  ...new Set([
    ...categoryRegistry,
    ...posts
      .filter((post) => !post.data.collection)
      .map((post) => post.data.category),
  ]),
].sort((a, b) => a.localeCompare(b, 'zh-CN'));
---

<BaseLayout title="分类" description="按主题浏览散篇笔记。">
  <div
    data-preview-kind="categories"
    data-content-version={categoryPreviewVersion(names)}
  >
    <header class="page-head shell">
      <p class="section-kicker">Categories</p>
      <h1 class="display">分类</h1>
      <p>
        按主题浏览散篇笔记。连续的学习笔记收录在{' '}
        <a href="/collections/">主题合集</a> 中。
      </p>
    </header>
    <section class="category-list shell" aria-label="分类列表">
      {names.map((name) => (
        <a href={`/categories/${encodeURIComponent(name)}/`}>
          <h2>{name}</h2>
          <span>{categoryPosts(posts, name).length} 篇文章 →</span>
        </a>
      ))}
      {!names.length && (
        <div class="empty-state">
          <h2>分类正在整理中</h2>
        </div>
      )}
    </section>
  </div>
</BaseLayout>
<style>
  .category-list {
    display: grid;
    gap: 1rem;
    padding-bottom: 4rem;
  }
  .category-list > a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 80px;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--line-color);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
  }
  h2 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 650;
  }
  span {
    color: var(--muted-ink);
    font-size: 0.8rem;
    white-space: nowrap;
  }
</style>
