---
import { getCollection } from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import categoryRegistry from '../../data/categories.json';import { categoryPosts, contentStats, postSlug, slugify, visiblePosts } from '../../lib/posts';
const posts=visiblePosts(await getCollection('blog'));const names=[...new Set([...categoryRegistry,...posts.filter(post=>!post.data.collection).map(post=>post.data.category)])].sort((a,b)=>a.localeCompare(b,'zh-CN'));const categories=names.map(name=>({name,id:`category-${slugify(name)}`,posts:categoryPosts(posts,name)}));
---
<BaseLayout title="文章分类" description="按主题展开浏览棱镜笔记的全部散篇。"><header class="page-head shell"><p class="section-kicker">Subject index / {categories.length}</p><h1 class="display">分类目录</h1><p>分类只收录散篇；合集文章按书籍章节独立组织。桌面端可使用右侧索引，移动端可从下拉菜单快速跳转。</p></header><div class="mobile-jump shell"><label for="category-jump">跳转到分类</label><select id="category-jump"><option value="">请选择</option>{categories.map(category=><option value={`#${category.id}`}>{category.name}（{category.posts.length}）</option>)}</select></div><div class="category-layout shell"><div class="category-books">{categories.map((category,number)=><section id={category.id} data-category-section><header><span>{String(number+1).padStart(2,'0')}</span><div><h2><a href={`/categories/${encodeURIComponent(category.name)}/`}>{category.name}</a></h2><p>{category.posts.length} 篇散篇</p></div></header><ol>{category.posts.map(post=>{const stats=contentStats(post.body);return <li><a href={`/blog/${postSlug(post)}/`}><span class="chapter">散篇</span><strong>{post.data.title}</strong><i></i><b>{stats.words.toLocaleString('zh-CN')} 字 · 约 {stats.minutes} 分钟</b></a></li>})}</ol></section>)}</div><aside class="category-index"><p>快速索引</p><ol>{categories.map((category,number)=><li><a href={`#${category.id}`} data-category-link={category.id}><span>{String(number+1).padStart(2,'0')}</span>{category.name}<b>{category.posts.length}</b></a></li>)}</ol></aside></div></BaseLayout>
<script>const select=document.querySelector<HTMLSelectElement>('#category-jump');select?.addEventListener('change',()=>{if(select.value)location.hash=select.value});const links=[...document.querySelectorAll<HTMLAnchorElement>('[data-category-link]')];const sections=[...document.querySelectorAll<HTMLElement>('[data-category-section]')];const mark=(id:string)=>links.forEach(link=>link.toggleAttribute('aria-current',link.dataset.categoryLink===id));if(sections[0])mark(sections[0].id);const observer=new IntersectionObserver(entries=>{const active=entries.filter(entry=>entry.isIntersecting).sort((a,b)=>a.boundingClientRect.top-b.boundingClientRect.top)[0];if(active)mark((active.target as HTMLElement).id)},{rootMargin:'-12% 0px -70% 0px'});sections.forEach(section=>observer.observe(section));</script>
<style>.category-layout{display:grid;grid-template-columns:minmax(0,1fr) 14rem;gap:clamp(2rem,6vw,5rem);padding-bottom:7rem}.category-books section{scroll-margin-top:90px;padding:2.2rem 0;border-top:1px solid var(--ink)}.category-books section>header{display:flex;gap:1.25rem;align-items:start}.category-books section>header>span{font:500 .75rem var(--font-sans);color:var(--accent)}.category-books h2{margin:0;font-size:2rem;font-weight:500}.category-books h2 a{text-decoration:none}.category-books header p{margin:.2rem 0;color:var(--muted-ink)}.category-books ol{margin:1.5rem 0 0;padding:0;list-style:none}.category-books li{border-bottom:1px solid var(--soft-line)}.category-books li a{display:flex;align-items:baseline;gap:.65rem;min-height:52px;padding:.7rem 0;text-decoration:none}.chapter{flex:0 0 auto;font-size:.72rem;color:var(--muted-ink)}.category-books strong{font-weight:500}.category-books li i{flex:1;border-bottom:1px dotted var(--line-color)}.category-books li b{font-weight:400}.category-index{position:sticky;top:95px;align-self:start;padding-left:1rem;border-left:1px solid var(--soft-line)}.category-index>p{font:500 .68rem var(--font-sans);text-transform:uppercase;letter-spacing:.1em}.category-index ol{padding:0;list-style:none}.category-index a{display:grid;grid-template-columns:2rem 1fr auto;gap:.35rem;padding:.45rem;text-decoration:none;color:var(--muted-ink);border-left:2px solid transparent}.category-index a[aria-current]{color:var(--ink);border-color:var(--accent);background:color-mix(in srgb,var(--accent) 7%,transparent)}.category-index b{font-weight:400}.mobile-jump{display:none}.mobile-jump label{font:500 .75rem var(--font-sans)}.mobile-jump select{width:100%;min-height:44px;margin-top:.4rem;padding:.5rem;border:1px solid var(--line-color);background:var(--paper);color:var(--ink)}@media(max-width:800px){.category-layout{grid-template-columns:1fr}.category-index{display:none}.mobile-jump{display:block;margin-bottom:2rem}.category-books li a{display:grid;grid-template-columns:1fr auto}.chapter{grid-column:1/-1}.category-books li i{display:none}}</style>
