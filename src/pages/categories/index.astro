---
import { getCollection } from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import { visiblePosts } from '../../lib/posts';const posts=visiblePosts(await getCollection('blog'));const categories=Object.entries(Object.groupBy(posts,p=>p.data.category)).sort((a,b)=>b[1]!.length-a[1]!.length);
---
<BaseLayout title="文章分类"><header class="page-head shell"><p class="section-kicker">Subject index</p><h1 class="display">分类</h1></header><section class="section"><ol class="shell taxonomy">{categories.map(([name,items])=><li><a href={`/categories/${encodeURIComponent(name)}/`}><strong>{name}</strong><span>{items?.length} 篇文章</span></a></li>)}</ol></section></BaseLayout>
<style>.taxonomy{max-width:var(--measure);margin-top:0;padding:0;list-style-position:inside;border-top:1px solid var(--line-color)}.taxonomy li{border-bottom:1px solid var(--soft-line)}.taxonomy a{display:inline-flex;width:calc(100% - 2rem);min-height:64px;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 0;text-decoration:none}.taxonomy strong{font-size:1.4rem;font-weight:500}.taxonomy span{font:500 .75rem var(--font-sans);color:var(--muted-ink)}</style>
