---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { visiblePosts } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = visiblePosts(await getCollection('blog'));
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}
const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`}>
  <header class="page-head shell">
    <a class="back" href="/tags/">
      ← 全部标签
    </a>
    <p class="section-kicker">Keyword / {posts.length}</p>
    <h1 class="display">{tag}</h1>
  </header>
  <section class="post-list">
    <div class="shell list">
      {posts.map((post: any, i: number) => (
        <PostCard post={post} index={i} />
      ))}
      {!posts.length && (
        <div class="empty-state">
          <h2>还没有收录的文章</h2>
          <p>
            也可以到 <a href="/blog/">Blog</a> 浏览全部笔记。
          </p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
<style>
  .list {
    padding-bottom: 4rem;
  }
  .back {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--muted-ink);
    margin-bottom: 1rem;
  }
</style>
