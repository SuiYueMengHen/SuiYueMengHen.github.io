---
import { getCollection } from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import { visiblePosts } from '../../lib/posts';
const posts=visiblePosts(await getCollection('blog'));const tags=Object.entries(Object.groupBy(posts.flatMap(p=>p.data.tags),t=>t)).sort((a,b)=>b[1]!.length-a[1]!.length);
---
<BaseLayout title="文章标签"><header class="page-head shell"><p class="section-kicker">Topic spectrum</p><h1 class="display">标签</h1></header><section class="section"><div class="shell cloud">{tags.map(([tag,items],i)=><a href={`/tags/${encodeURIComponent(tag)}/`} style={`--n:${Math.min(3,items?.length||1)}`}><span>#{tag}</span><small>{items?.length} / {String(i+1).padStart(2,'0')}</small></a>)}</div></section></BaseLayout><style>.cloud{display:flex;flex-wrap:wrap;align-items:center;gap:1rem}.cloud a{display:flex;gap:1rem;align-items:start;padding:1rem;border:var(--line);font-size:calc(1rem + var(--n)*.55rem);font-weight:800;text-decoration:none}.cloud a:nth-child(3n+1):hover{background:var(--red);color:#fff}.cloud a:nth-child(3n+2):hover{background:var(--blue);color:#fff}.cloud a:nth-child(3n):hover{background:var(--yellow);color:#151514}.cloud small{font:.6rem var(--font-mono)}</style>
