---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到">
  <section class="not-found shell" data-preview-kind="not-found">
    <p class="error">404</p>
    <h1>页面未找到</h1>
    <p>这个地址可能已经移动，试试返回首页或搜索文章。</p>
    <div>
      <a class="button" href="/">
        返回首页
      </a>
      <a class="button button--ghost" href="/search/">
        搜索文章
      </a>
    </div>
  </section>
</BaseLayout>
<style>
  .not-found {
    max-width: var(--measure);
    min-height: 65dvh;
    display: grid;
    place-content: center;
    text-align: center;
    padding-block: 4rem;
  }
  .error {
    margin: 0;
    font-size: clamp(5rem, 18vw, 8rem);
    line-height: 1;
    font-weight: 750;
    color: var(--muted-ink);
  }
  h1 {
    margin: 1.5rem 0 0.5rem;
    font-size: 1.8rem;
  }
  p {
    color: var(--muted-ink);
  }
  .not-found div {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }
</style>
