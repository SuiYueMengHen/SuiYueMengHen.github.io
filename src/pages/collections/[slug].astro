---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  collectionPosts,
  contentStats,
  postSlug,
  sortedCollections,
  visiblePosts,
} from '../../lib/posts';
import { collectionPreviewVersion } from '../../lib/preview-version';
export async function getStaticPaths() {
  const items = sortedCollections(await getCollection('collections'));
  const posts = visiblePosts(await getCollection('blog'));
  return items.map((collection) => ({
    params: { slug: collection.id },
    props: { collection, chapters: collectionPosts(posts, collection.id) },
  }));
}
const { collection, chapters } = Astro.props;
---

<BaseLayout
  title={collection.data.title}
  description={collection.data.description}
>
  <div
    data-preview-kind="collection"
    data-preview-id={collection.id}
    data-content-version={collectionPreviewVersion(collection.data)}
  >
    <header class="page-head shell collection-head">
      <a href="/collections/" class="back">
        ← 主题合集
      </a>
      <p class="section-kicker">{collection.data.volume || 'Collection'}</p>
      <h1 class="display">{collection.data.title}</h1>
      {collection.data.subtitle && <p>{collection.data.subtitle}</p>}
      <p>{collection.data.description}</p>
    </header>
    <section class="collection-toc shell" aria-label="合集章节">
      <ol>
        {chapters.map((post: any) => (
          <li>
            <a href={`/blog/${postSlug(post)}/`}>
              <small>第 {post.data.collectionOrder} 章</small>
              <div>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
              </div>
              <span>{contentStats(post.body).minutes} 分钟 →</span>
            </a>
          </li>
        ))}
      </ol>
      {!chapters.length && (
        <div class="empty-state">
          <h2>章节正在整理中</h2>
          <p>新的笔记将在这里更新。</p>
        </div>
      )}
    </section>
  </div>
</BaseLayout>
<style>
  .back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    font-size: 0.85rem;
    color: var(--muted-ink);
    margin-bottom: 1rem;
  }
  .collection-head {
    max-width: var(--measure);
  }
  .collection-toc {
    max-width: var(--measure);
    padding-bottom: 4rem;
  }
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    border-top: 1px solid var(--soft-line);
  }
  li:last-child {
    border-bottom: 1px solid var(--soft-line);
  }
  li a {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding: 1.5rem 0;
    text-decoration: none;
  }
  small,
  span {
    flex-shrink: 0;
    color: var(--muted-ink);
    font-size: 0.8rem;
  }
  li a > div {
    flex: 1;
    min-width: 0;
  }
  h2 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 650;
    overflow-wrap: anywhere;
  }
  li p {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    color: var(--muted-ink);
  }
  @media (max-width: 640px) {
    li a {
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    li a > div {
      flex-basis: 100%;
      order: 1;
    }
    span {
      margin-left: auto;
    }
  }
</style>
