---
import { getCollection } from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import { collectionPosts, contentStats, postSlug, sortedCollections, visiblePosts } from '../../lib/posts';
export async function getStaticPaths(){const items=sortedCollections(await getCollection('collections'));const posts=visiblePosts(await getCollection('blog'));return items.map(collection=>({params:{slug:collection.id},props:{collection,chapters:collectionPosts(posts,collection.id)}}))}
const{collection,chapters}=Astro.props;
---
<BaseLayout title={collection.data.title} description={collection.data.description}><header class="collection-head shell"><p>{collection.data.volume||'Prism Notes Collection'}</p><h1>{collection.data.title}</h1>{collection.data.subtitle&&<em>{collection.data.subtitle}</em>}<span>{collection.data.description}</span></header><section class="collection-toc shell"><ol>{chapters.map((post:any)=>{const stats=contentStats(post.body);return <li><a href={`/blog/${postSlug(post)}/`}><small>第 {post.data.collectionOrder} 章</small><strong>{post.data.title}</strong><i></i><b>{stats.words.toLocaleString('zh-CN')} 字 · 约 {stats.minutes} 分钟</b></a><p>{post.data.description}</p></li>})}</ol></section></BaseLayout>
<style>.collection-head{max-width:var(--measure);padding:clamp(5rem,12vw,9rem) 0 3rem;text-align:center;border-bottom:3px double var(--ink)}.collection-head p{font:500 .7rem var(--font-sans);letter-spacing:.15em;text-transform:uppercase}.collection-head h1{margin:1rem 0 .5rem;font-size:clamp(3rem,9vw,6rem);font-weight:500;line-height:1}.collection-head em{display:block;font-size:1.25rem}.collection-head span{display:block;max-width:36rem;margin:2rem auto 0;color:var(--muted-ink)}.collection-toc{max-width:var(--measure);padding:2rem 0 7rem}.collection-toc ol{padding:0;list-style:none}.collection-toc li{padding:1rem 0;border-bottom:1px solid var(--soft-line)}.collection-toc a{display:flex;gap:.75rem;align-items:baseline;text-decoration:none}.collection-toc small{color:var(--muted-ink)}.collection-toc strong{font-size:1.2rem;font-weight:500}.collection-toc i{flex:1;border-bottom:1px dotted var(--line-color)}.collection-toc b{font:500 .72rem var(--font-sans)}.collection-toc p{margin:.35rem 0 0 4.8rem;color:var(--muted-ink)}@media(max-width:600px){.collection-toc a{display:grid;grid-template-columns:auto 1fr}.collection-toc i{display:none}.collection-toc p{margin-left:0}}</style>
