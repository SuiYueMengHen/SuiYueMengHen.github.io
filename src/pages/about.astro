---
import BaseLayout from '../layouts/BaseLayout.astro';import { siteConfig } from '../config/site';
---
<BaseLayout title="关于" description={`关于${siteConfig.name}与作者${siteConfig.author.name}。`}>
  <header class="page-head shell"><p class="section-kicker">About</p><h1 class="display">关于本刊</h1><p>{siteConfig.description}</p></header>
  <article class="about shell">
    <section><h2>摘要</h2><p class="lead">「棱镜笔记」是一份由 {siteConfig.author.name} 独立维护的个人写作刊物，记录技术、创造与日常观察。</p><p>它不追逐即时热点，而把每篇文章视为可持续修订的研究札记。文章可能关于代码和工具，也可能关于创作方法、阅读，以及生活中值得重新观看的细节。</p></section>
    <section><h2>写作原则</h2><ol><li><strong>诚实。</strong>只写真正经历、学习和思考过的事情。</li><li><strong>清晰。</strong>不拿复杂冒充深刻，把推理过程交代完整。</li><li><strong>长期。</strong>允许文章被修订、连接，并随理解一同生长。</li></ol></section>
    <section><h2>作者</h2><p>{siteConfig.author.bio} 所有文章、插图与站点源码均保存在公开的 GitHub 仓库中。</p><p><a href={siteConfig.author.github}>GitHub：{siteConfig.author.name}&nbsp;↗</a></p></section>
    <footer><p>Correspondence concerning this website may be addressed through GitHub Discussions.</p></footer>
  </article>
</BaseLayout>
<style>.about{max-width:var(--measure);padding-bottom:7rem}.about section{padding:2.5rem 0;border-top:1px solid var(--soft-line)}.about h2{font-size:1.55rem;font-weight:500}.about h2::before{content:'§ ';color:var(--accent)}.lead{font-size:1.25rem}.about p,.about li{text-align:justify}.about li{margin:.8rem 0}.about footer{margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--ink);font-size:.88rem;font-style:italic;color:var(--muted-ink)}</style>
