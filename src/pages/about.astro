---
import BaseLayout from '../layouts/BaseLayout.astro';import { siteConfig } from '../config/site';
---
<BaseLayout title="关于" description={`关于${siteConfig.name}与作者${siteConfig.author.name}。`}>
  <header class="about-hero shell"><div class="about-title"><p class="section-kicker">About the observer</p><h1>你好，<br />我是 <span>{siteConfig.author.name}</span>。</h1></div><div class="portrait" aria-label="SuiYueMengHen 的几何字母头像" role="img"><span>S</span><i>M</i><b>H</b><small>OBSERVER / WRITER</small></div></header>
  <section class="section"><div class="shell grid-12 about-copy"><h2>关于这本笔记</h2><div><p class="lead">{siteConfig.description}</p><p>「棱镜笔记」不是一份追逐热点的内容清单，而是一处长期维护的个人写作空间。文章可能关于代码和工具，也可能关于创作方法、阅读，以及生活中那些值得重新观看的细节。</p><p>棱镜把一道光拆成不同颜色。写作也一样：它让混杂的经验显出结构，让模糊的感受获得名字。</p></div></div></section>
  <section class="principles"><div class="shell"><p class="section-kicker">Three principles</p><div><article><span>01</span><h2>诚实</h2><p>只写真正经历、学习和思考过的事情。</p></article><article><span>02</span><h2>清晰</h2><p>不拿复杂冒充深刻，把推理过程交代完整。</p></article><article><span>03</span><h2>长期</h2><p>把博客当作会持续生长的数字花园。</p></article></div></div></section>
  <section class="section"><div class="shell contact"><div><p class="section-kicker">Find me online</p><h2>保持联系</h2></div><a class="button" href={siteConfig.author.github}>访问 GitHub <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>
<style>.about-hero{display:grid;grid-template-columns:7fr 5fr;gap:3rem;min-height:calc(100dvh - 76px);align-items:center;padding-block:4rem}.about-title h1{font-size:clamp(3.5rem,8vw,8rem);line-height:.92;letter-spacing:-.065em}.about-title h1 span{color:var(--red)}.portrait{position:relative;aspect-ratio:4/5;display:grid;place-items:center;border:4px solid var(--ink);background:var(--yellow);overflow:hidden;font-size:clamp(8rem,20vw,18rem);font-weight:900}.portrait i,.portrait b{position:absolute;font-style:normal;mix-blend-mode:multiply}.portrait i{color:var(--blue);left:-5%;top:20%}.portrait b{color:var(--red);right:-8%;bottom:-8%}.portrait small{position:absolute;left:1rem;bottom:1rem;font:.65rem var(--font-mono)}.about-copy>h2{grid-column:1/5;font-size:2rem}.about-copy>div{grid-column:6/12;max-width:680px;font-family:var(--font-serif);font-size:1.15rem}.about-copy .lead{font-family:var(--font-sans);font-size:clamp(1.8rem,3.5vw,3rem);line-height:1.25;font-weight:750}.principles{padding-block:6rem;background:var(--red);color:#fff}.principles .section-kicker::before{border-color:var(--yellow)}.principles .shell>div{display:grid;grid-template-columns:repeat(3,1fr);margin-top:3rem;border-top:1px solid #fff}.principles article{padding:2rem;border-right:1px solid #fff}.principles article:last-child{border:0}.principles span{font:.7rem var(--font-mono)}.principles h2{font-size:3rem;margin:2rem 0 .5rem}.contact{display:flex;align-items:end;justify-content:space-between;gap:2rem}.contact h2{margin:0;font-size:clamp(3rem,7vw,7rem)}@media(max-width:760px){.about-hero{grid-template-columns:1fr}.portrait{max-height:600px}.about-copy>h2,.about-copy>div{grid-column:auto}.principles .shell>div{grid-template-columns:1fr}.principles article{border-right:0;border-bottom:1px solid #fff}.contact{align-items:start;flex-direction:column}}</style>
