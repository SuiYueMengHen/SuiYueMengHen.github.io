---
import { getCollection } from 'astro:content';import BaseLayout from '../layouts/BaseLayout.astro';import PrismLogo from '../components/PrismLogo.astro';import ProjectCard from '../components/ProjectCard.astro';import { siteConfig } from '../config/site';import { sortedProjects } from '../lib/posts';
const projects=sortedProjects(await getCollection('projects')).filter(project=>project.data.featured).slice(0,2);
---
<BaseLayout title="关于" description={`关于${siteConfig.name}与作者${siteConfig.author.name}。`}><header class="about-hero shell"><div class="about-mark"><PrismLogo size={150}/><span aria-hidden="true">P/N</span></div><div><p class="section-kicker">About the journal</p><h1>慢一点思考，<br/>认真地记录。</h1><p class="lead">{siteConfig.description}</p><a class="button button--ghost" href={siteConfig.author.github}>在 GitHub 找到我 ↗</a></div></header><section class="about-grid shell"><article class="profile"><span>作者 / Editor</span><h2>{siteConfig.author.name}</h2><p>{siteConfig.author.bio} 这里的文章不是内容流水线，而是可以被修订、交叉引用并长期生长的公开笔记。</p></article>{siteConfig.author.focus.length>0&&<article><span>关注方向 / Focus</span><ul>{siteConfig.author.focus.map((item,index)=><li><b>{String(index+1).padStart(2,'0')}</b>{item}</li>)}</ul></article>}</section>{siteConfig.author.principles.length>0&&<section class="principles"><div class="shell"><header><p class="section-kicker">Editorial principles</p><h2>写作原则</h2></header><div>{siteConfig.author.principles.map((item,index)=><article><span>§ {index+1}</span><h3>{item.title}</h3><p>{item.description}</p></article>)}</div></div></section>}{projects.length>0&&<section class="about-projects shell"><header><p class="section-kicker">Current work</p><h2>正在构建</h2></header><div>{projects.map(project=><ProjectCard project={project} compact/>)}</div></section>}<footer class="correspondence shell"><p>Correspondence</p><h2>所有文章、插图与站点源码都保存在公开仓库中。</h2><div><a href={siteConfig.author.github}>GitHub ↗</a><a href="/rss.xml">RSS ↗</a></div></footer></BaseLayout>
<style>.about-hero{min-height:min(720px,80dvh);display:grid;grid-template-columns:4fr 7fr;align-items:center;gap:clamp(2rem,8vw,7rem);padding-block:5rem;border-bottom:1px solid var(--ink)}.about-mark{position:relative;display:grid;place-items:center;aspect-ratio:1;border:1px solid var(--line-color)}.about-mark>span{position:absolute;right:1rem;bottom:.7rem;font:500 .7rem var(--font-sans);letter-spacing:.15em}.about-hero h1{margin:1rem 0;font-size:clamp(3rem,7vw,6.5rem);font-weight:500;line-height:1}.lead{max-width:38rem;font-size:1.2rem;color:var(--muted-ink)}.about-grid{display:grid;grid-template-columns:1fr 1fr;padding-block:5rem}.about-grid article{padding:2rem;border-left:1px solid var(--soft-line)}.about-grid article>span,.principles article>span{font:500 .68rem var(--font-sans);text-transform:uppercase;letter-spacing:.1em;color:var(--muted-ink)}.about-grid h2{font-size:2.2rem;font-weight:500}.about-grid ul{margin:1rem 0;padding:0;list-style:none}.about-grid li{display:flex;gap:1rem;padding:.75rem 0;border-bottom:1px solid var(--soft-line)}.about-grid li b{font:500 .7rem var(--font-sans);color:var(--accent)}.principles{padding:5rem 0;border-block:1px solid var(--line-color);background:var(--surface)}.principles>.shell>header{display:flex;align-items:baseline;justify-content:space-between}.principles h2,.about-projects h2{font-size:clamp(2rem,5vw,3rem);font-weight:500}.principles>.shell>div{display:grid;grid-template-columns:repeat(3,1fr)}.principles article{padding:2rem;border-left:1px solid var(--soft-line)}.principles h3{font-size:1.55rem;font-weight:500}.about-projects{padding-block:5rem}.about-projects>div{display:grid;grid-template-columns:repeat(2,1fr);gap:1.5rem}.correspondence{padding:5rem 0 7rem;border-top:1px solid var(--ink)}.correspondence>p{font:500 .7rem var(--font-sans);text-transform:uppercase}.correspondence h2{max-width:48rem;font-size:clamp(2rem,5vw,4rem);font-weight:500;line-height:1.15}.correspondence div{display:flex;gap:1.5rem}@media(max-width:760px){.about-hero{grid-template-columns:1fr;min-height:0}.about-mark{max-width:15rem}.about-grid,.principles>.shell>div,.about-projects>div{grid-template-columns:1fr}.about-grid article,.principles article{border-left:0;border-top:1px solid var(--soft-line);padding-inline:0}}</style>
