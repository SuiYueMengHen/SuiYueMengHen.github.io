---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, postSlug, visiblePosts } from '../../lib/posts';
import '../../styles/blog.css';
import 'katex/dist/katex.min.css';
export async function getStaticPaths() {
  return visiblePosts(await getCollection('blog'), import.meta.env.DEV).map(
    (post) => ({
      params: { slug: postSlug(post) },
      props: { post },
    }),
  );
}
const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description || post.data.title}
  image={post.data.cover?.src}
  canonical={post.data.canonical}
  type="article"
  publishedTime={post.data.publishDate}
  updatedTime={post.data.updatedDate}
>
  <article class="blog-shell article">
    <a class="blog-back" href="/blog/">
      ← Blog
    </a>
    {post.data.cover && (
      <div class="article-cover">
        <Image
          src={post.data.cover}
          alt={post.data.coverAlt || ''}
          widths={[640, 960, 1440]}
          sizes="(max-width: 760px) 100vw, 720px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )}
    <header class="article-head">
      <h1 data-pagefind-meta="title">{post.data.title}</h1>
      <div class="article-meta">
        <time datetime={post.data.publishDate.toISOString()}>
          {formatDate(post.data.publishDate)}
        </time>
        {post.data.draft && <span>草稿</span>}
        {post.data.updatedDate && (
          <span>更新于 {formatDate(post.data.updatedDate)}</span>
        )}
      </div>
      {post.data.tags.length > 0 && (
        <nav class="article-tags" aria-label="文章标签">
          {post.data.tags.map((tag: string) => (
            <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
          ))}
        </nav>
      )}
    </header>
    <div class="prose" data-pagefind-body>
      <Content />
    </div>
    <footer class="article-end">
      <a href="/blog/">← 返回 Blog</a>
    </footer>
  </article>
</BaseLayout>
