---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Giscus from '../../components/Giscus.astro';
import { formatDate, postSlug, readingMinutes, relatedPosts, visiblePosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = visiblePosts(await getCollection('blog'));
  return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post, posts } }));
}
const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const slug = postSlug(post);
const related = relatedPosts(post, posts);
const index = posts.findIndex((item: typeof post) => item.id === post.id);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index < posts.length - 1 ? posts[index + 1] : undefined;
const shareUrl = new URL(`/blog/${slug}/`, Astro.site).toString();
---
<BaseLayout title={post.data.title} description={post.data.description} canonical={post.data.canonical} type="article" publishedTime={post.data.publishDate} updatedTime={post.data.updatedDate}>
  <div class="reading-progress" aria-hidden="true"></div>
  <article>
    <header class="article-head shell">
      <div class="article-number">NOTE / {String(index + 1).padStart(3,'0')}</div>
      <div class="article-title"><div class="meta"><a href={`/categories/${encodeURIComponent(post.data.category)}/`}>{post.data.category}</a><span>{formatDate(post.data.publishDate)}</span><span>{readingMinutes(post.body)} 分钟阅读</span></div><h1>{post.data.title}</h1><p>{post.data.description}</p><div class="tags">{post.data.tags.map((tag:string)=><a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}</div></div>
      <div class="article-shape" aria-hidden="true"><span></span><i></i><b></b></div>
    </header>
    <div class="article-layout shell">
      <aside class="toc" aria-label="文章目录"><p>本页目录</p><ol>{headings.filter((h:any)=>h.depth<=3).map((heading:any)=><li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></aside>
      <div class="prose" data-pagefind-body><Content /></div>
      <aside class="article-rail"><div><span>Published</span><time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time></div>{post.data.updatedDate&&<div><span>Updated</span><time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate)}</time></div>}<div class="share"><span>Share</span><a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(post.data.title)}`}>X / Twitter ↗</a><button id="copy-link" type="button">复制链接</button><span id="copy-status" role="status" aria-live="polite"></span></div></aside>
    </div>
    <div class="article-end shell"><span aria-hidden="true">◇</span><p>感谢阅读到这里。</p></div>
    <nav class="post-nav shell" aria-label="相邻文章">{newer?<a href={`/blog/${postSlug(newer)}/`}><small>上一篇 / NEWER</small><strong>{newer.data.title}</strong></a>:<span></span>}{older&&<a href={`/blog/${postSlug(older)}/`}><small>下一篇 / OLDER</small><strong>{older.data.title}</strong></a>}</nav>
    {related.length>0&&<section class="section"><div class="shell"><p class="section-kicker">Related reflections</p><h2 class="section-heading">继续阅读</h2><div class="related-grid">{related.map((item:any,i:number)=><PostCard post={item} index={i}/>)}</div></div></section>}
    <div class="shell"><Giscus /></div>
  </article>
</BaseLayout>
<script>
  const progress = document.querySelector<HTMLElement>('.reading-progress');
  const updateProgress = () => { if(progress) progress.style.transform = `scaleX(${scrollY / Math.max(1, document.documentElement.scrollHeight - innerHeight)})`; };
  addEventListener('scroll', updateProgress, { passive: true }); updateProgress();
  document.querySelector<HTMLButtonElement>('#copy-link')?.addEventListener('click', async () => { await navigator.clipboard.writeText(location.href); const status=document.querySelector('#copy-status'); if(status) status.textContent='已复制'; });
  document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => { const button=document.createElement('button'); button.className='copy-code'; button.type='button'; button.textContent='复制'; button.setAttribute('aria-label','复制代码'); button.addEventListener('click',async()=>{await navigator.clipboard.writeText(pre.innerText.replace(/^复制/,''));button.textContent='已复制';setTimeout(()=>button.textContent='复制',1600)}); pre.append(button); });
</script>
<style>
  .reading-progress{position:fixed;z-index:200;left:0;top:0;width:100%;height:4px;background:var(--red);transform:scaleX(0);transform-origin:left}.article-head{position:relative;display:grid;grid-template-columns:2fr 8fr 2fr;gap:2rem;padding-block:clamp(5rem,10vw,9rem);border-bottom:var(--line)}.article-number{font:.7rem var(--font-mono)}.article-title h1{margin:1.5rem 0;font-size:clamp(3rem,8vw,7.5rem);line-height:.92;letter-spacing:-.065em}.article-title>p{max-width:720px;font-size:1.25rem;color:var(--muted-ink)}.meta{display:flex;flex-wrap:wrap;gap:.6rem 1.5rem;font:.7rem var(--font-mono);text-transform:uppercase}.tags{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:2rem}.article-shape{position:relative;min-height:200px}.article-shape span{position:absolute;right:0;top:0;width:100%;aspect-ratio:1;border:12px solid var(--blue);border-radius:50%}.article-shape i{position:absolute;right:15%;bottom:5%;width:70%;aspect-ratio:1;background:var(--red);clip-path:polygon(50% 0,100% 100%,0 100%);mix-blend-mode:multiply}.article-layout{display:grid;grid-template-columns:2fr 7fr 3fr;gap:clamp(1.5rem,4vw,4rem);padding-block:clamp(4rem,8vw,8rem)}.toc{position:sticky;top:110px;align-self:start;font-size:.8rem}.toc>p,.article-rail span{font:700 .65rem var(--font-mono);letter-spacing:.1em;text-transform:uppercase}.toc ol{list-style:none;padding:0}.toc li{margin:.7rem 0}.toc .depth-3{padding-left:.75rem}.toc a{text-decoration:none;color:var(--muted-ink)}.toc a:hover{color:var(--red)}.article-rail{position:sticky;top:110px;align-self:start;display:grid;gap:1.5rem;font-size:.8rem}.article-rail>div{display:grid;gap:.3rem;padding-top:.75rem;border-top:var(--line)}.article-rail button{min-height:44px;border:0;padding:0;background:transparent;color:inherit;text-align:left;text-decoration:underline;cursor:pointer}.prose{min-width:0;font-family:var(--font-serif);font-size:clamp(1.08rem,1.5vw,1.2rem);line-height:1.9}.prose :global(h2),.prose :global(h3){font-family:var(--font-sans);letter-spacing:-.035em;scroll-margin-top:110px}.prose :global(h2){margin:3.5rem 0 1rem;font-size:2.2rem}.prose :global(h3){margin:2.5rem 0 1rem;font-size:1.55rem}.prose :global(p),.prose :global(ul),.prose :global(ol){max-width:72ch}.prose :global(a){color:var(--blue);font-weight:650}.prose :global(blockquote){margin:2.5rem 0;padding:1.5rem 2rem;border-left:8px solid var(--red);background:var(--surface);font-size:1.3rem}.prose :global(pre){position:relative;margin:2rem 0;padding:1.5rem;border:1px solid #444;overflow:auto;font-size:.85rem}.prose :global(.copy-code){position:absolute;right:.5rem;top:.5rem;min-height:36px;padding:.25rem .6rem;border:1px solid #aaa;background:#161b22;color:#fff;cursor:pointer}.prose :global(code:not(pre code)){padding:.15em .35em;background:color-mix(in srgb,var(--blue) 12%,transparent);font-family:var(--font-mono);font-size:.88em}.prose :global(img){width:100%;height:auto;margin:2rem 0}.prose :global(table){display:block;max-width:100%;overflow-x:auto;border-collapse:collapse;font-family:var(--font-sans);font-size:.9rem}.prose :global(th),.prose :global(td){padding:.6rem;border:var(--line)}.article-end{text-align:center;padding-block:5rem;border-top:var(--line)}.article-end span{font-size:4rem;color:var(--red)}.post-nav{display:grid;grid-template-columns:1fr 1fr;border:var(--line)}.post-nav a{display:grid;gap:.75rem;min-height:180px;padding:2rem;text-decoration:none}.post-nav a+a{border-left:var(--line);text-align:right}.post-nav a:hover{background:var(--blue);color:#fff}.post-nav small{font:700 .65rem var(--font-mono)}.post-nav strong{font-size:1.45rem}.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}
  @media(max-width:900px){.article-head{grid-template-columns:1fr}.article-shape{display:none}.article-layout{grid-template-columns:1fr}.toc{position:static;border:var(--line);padding:1rem}.article-rail{position:static;grid-template-columns:repeat(3,1fr);grid-row:2}.related-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:600px){.article-rail{grid-template-columns:1fr}.post-nav{grid-template-columns:1fr}.post-nav a+a{border-left:0;border-top:var(--line);text-align:left}.related-grid{grid-template-columns:1fr}.prose{font-family:var(--font-sans)}}
</style>
