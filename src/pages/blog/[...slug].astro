---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Giscus from '../../components/Giscus.astro';
import { siteConfig } from '../../config/site';
import { formatDate, postSlug, readingMinutes, relatedPosts, visiblePosts } from '../../lib/posts';
export async function getStaticPaths(){const posts=visiblePosts(await getCollection('blog'));return posts.map((post)=>({params:{slug:postSlug(post)},props:{post,posts}}))}
const{post,posts}=Astro.props;const{Content,headings}=await render(post);const slug=postSlug(post);const related=relatedPosts(post,posts);const index=posts.findIndex((item:typeof post)=>item.id===post.id);const newer=index>0?posts[index-1]:undefined;const older=index<posts.length-1?posts[index+1]:undefined;const shareUrl=new URL(`/blog/${slug}/`,Astro.site).toString();
let chapter=0,section=0,subsection=0;
const numberedHeadings=headings.filter((heading:any)=>heading.depth>=2&&heading.depth<=4).map((heading:any)=>{if(heading.depth===2){chapter++;section=0;subsection=0}else if(heading.depth===3){section++;subsection=0}else{subsection++}const number=heading.depth===2?`第${chapter}章`:heading.depth===3?`§${chapter}.${section}`:`§${chapter}.${section}.${subsection}`;return{...heading,number}});
---
<BaseLayout title={post.data.title} description={post.data.description} canonical={post.data.canonical} type="article" publishedTime={post.data.publishDate} updatedTime={post.data.updatedDate}>
  <div class="reading-progress" aria-hidden="true"></div>
  <article>
    <header class="article-head shell"><p class="journal">{`Prism Notes · No. ${String(index+1).padStart(3,'0')}`}</p><h1>{post.data.title}</h1><p class="description">{post.data.description}</p><div class="byline"><span>{post.data.category}</span><span>{siteConfig.author.name}</span><time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time><span>{readingMinutes(post.body)} 分钟阅读</span></div><div class="tags">{post.data.tags.map((tag:string)=><a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}</div></header>
    {numberedHeadings.length>0&&<nav class="book-toc shell" aria-label="文章目录"><header><p>Contents</p><h2>目录</h2></header><ol>{numberedHeadings.map((heading:any)=><li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}><span class="toc-number">{heading.number}</span><span class="toc-title">{heading.text}</span><span class="leader" aria-hidden="true"></span><span class="jump" aria-hidden="true">↘</span></a></li>)}</ol></nav>}
    {numberedHeadings.length>0&&<nav class="side-toc" aria-label="随文目录"><p>本页章节</p><ol>{numberedHeadings.map((heading:any)=><li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`} data-section={heading.slug}><span>{heading.number}</span>{heading.text}</a></li>)}</ol><a class="back-top" href="#main-content">返回页首 ↑</a></nav>}
    <div class="prose shell" data-pagefind-body><Content /></div>
    <footer class="article-notes shell"><div><strong>引用本文</strong><p>{siteConfig.author.name}. “{post.data.title}.” <em>{siteConfig.name}</em>, {formatDate(post.data.publishDate)}.</p></div><div><strong>分享</strong><p><a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(post.data.title)}`}>X / Twitter</a> · <button id="copy-link" type="button">复制链接</button> <span id="copy-status" role="status" aria-live="polite"></span></p></div></footer>
    <nav class="post-nav shell" aria-label="相邻文章">{newer?<a href={`/blog/${postSlug(newer)}/`}><small>← 上一篇</small><strong>{newer.data.title}</strong></a>:<span></span>}{older&&<a href={`/blog/${postSlug(older)}/`}><small>下一篇 →</small><strong>{older.data.title}</strong></a>}</nav>
    {related.length>0&&<section class="section related"><div class="shell"><p class="section-kicker">Related works</p><h2 class="section-heading">相关文字</h2>{related.map((item:any,i:number)=><PostCard post={item} index={i}/>)}</div></section>}
    <div class="shell"><Giscus /></div>
  </article>
</BaseLayout>
<script>
  const progress=document.querySelector<HTMLElement>('.reading-progress');const updateProgress=()=>{if(progress)progress.style.transform=`scaleX(${scrollY/Math.max(1,document.documentElement.scrollHeight-innerHeight)})`};addEventListener('scroll',updateProgress,{passive:true});updateProgress();
  document.querySelector<HTMLButtonElement>('#copy-link')?.addEventListener('click',async()=>{await navigator.clipboard.writeText(location.href);const status=document.querySelector('#copy-status');if(status)status.textContent='已复制'});
  document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre)=>{const button=document.createElement('button');button.className='copy-code';button.type='button';button.textContent='复制';button.setAttribute('aria-label','复制代码');button.addEventListener('click',async()=>{await navigator.clipboard.writeText(pre.innerText.replace(/^复制/,''));button.textContent='已复制';setTimeout(()=>button.textContent='复制',1600)});pre.append(button)});
  const sectionLinks=[...document.querySelectorAll<HTMLAnchorElement>('.side-toc [data-section]')];const sections=sectionLinks.map((link)=>document.getElementById(link.dataset.section||'')).filter(Boolean) as HTMLElement[];
  const setActive=(id:string)=>sectionLinks.forEach((link)=>link.toggleAttribute('aria-current',link.dataset.section===id));
  if(sections.length){setActive(sections[0].id);const observer=new IntersectionObserver((entries)=>{const visible=entries.filter((entry)=>entry.isIntersecting).sort((a,b)=>a.boundingClientRect.top-b.boundingClientRect.top);if(visible[0])setActive((visible[0].target as HTMLElement).id)},{rootMargin:'-15% 0px -70% 0px',threshold:[0,1]});sections.forEach((section)=>observer.observe(section));}
</script>
<style>
  .reading-progress{position:fixed;z-index:200;left:0;top:0;width:100%;height:2px;background:var(--accent);transform:scaleX(0);transform-origin:left}.article-head{max-width:var(--measure);padding:clamp(4rem,10vw,7rem) 0 3rem;text-align:center;border-bottom:1px solid var(--ink)}.journal{font:500 .75rem var(--font-sans);letter-spacing:.11em;text-transform:uppercase;color:var(--muted-ink)}.article-head h1{margin:1.8rem auto 1.2rem;font-size:clamp(2.6rem,7vw,4.8rem);font-weight:500;line-height:1.12}.description{max-width:38rem;margin-inline:auto;font-size:1.15rem;font-style:italic;color:var(--muted-ink)}.byline,.tags{display:flex;justify-content:center;flex-wrap:wrap;gap:.4rem 1rem;margin-top:1.8rem;font:500 .76rem var(--font-sans)}.byline span+span::before,.byline time::before{content:'·';margin-right:1rem;color:var(--muted-ink)}.tags{margin-top:.8rem}.tags a{text-decoration:none}
  .book-toc{max-width:var(--measure);margin-top:2.5rem;padding:2rem clamp(1.25rem,4vw,3rem);border:1px solid var(--line-color);box-shadow:inset 0 0 0 5px var(--paper),inset 0 0 0 6px var(--soft-line)}.book-toc header{text-align:center;margin-bottom:1.5rem}.book-toc header p{margin:0;font:500 .68rem var(--font-sans);letter-spacing:.15em;text-transform:uppercase;color:var(--muted-ink)}.book-toc h2{margin:.2rem 0;font-size:1.65rem;font-weight:500}.book-toc ol{margin:0;padding:0;list-style:none}.book-toc li{margin:.35rem 0}.book-toc a{min-height:40px;display:flex;align-items:baseline;gap:.55rem;text-decoration:none}.book-toc .depth-3{padding-left:1.5rem;font-size:.92rem}.book-toc .depth-4{padding-left:3rem;font-size:.85rem;color:var(--muted-ink)}.toc-number{flex:0 0 auto;font-variant-numeric:tabular-nums;color:var(--muted-ink)}.toc-title{flex:0 1 auto}.leader{flex:1 1 auto;min-width:1rem;border-bottom:1px dotted var(--line-color);transform:translateY(-.25em)}.jump{font-size:.75rem;color:var(--muted-ink)}
  .side-toc{position:fixed;z-index:30;right:2rem;top:100px;width:13.5rem;max-height:calc(100dvh - 130px);overflow:auto;padding-left:1rem;border-left:1px solid var(--soft-line);font-size:.77rem}.side-toc>p{margin:0 0 .8rem;font:500 .66rem var(--font-sans);letter-spacing:.1em;text-transform:uppercase}.side-toc ol{margin:0;padding:0;list-style:none}.side-toc li{margin:.3rem 0}.side-toc .depth-3{padding-left:.65rem}.side-toc .depth-4{padding-left:1.3rem}.side-toc a{display:block;padding:.25rem .4rem;text-decoration:none;color:var(--muted-ink);border-left:2px solid transparent}.side-toc a span{margin-right:.35rem;font-variant-numeric:tabular-nums}.side-toc a[aria-current]{border-left-color:var(--accent);background:color-mix(in srgb,var(--accent) 7%,transparent);color:var(--ink)}.back-top{margin-top:1rem;font-family:var(--font-sans)}
  .prose{counter-reset:chapter;max-width:var(--measure);padding-block:clamp(3.5rem,8vw,6rem);font-size:var(--reader-font-size);line-height:var(--reader-line-height)}.prose :global(h2),.prose :global(h3),.prose :global(h4){scroll-margin-top:90px;font-weight:500}.prose :global(h2){counter-increment:chapter;counter-reset:section subsection;margin:3.5rem 0 1.25rem;font-size:1.8rem}.prose :global(h2::before){content:'第' counter(chapter) '章\00a0';color:var(--accent)}.prose :global(h3){counter-increment:section;counter-reset:subsection;margin:2.7rem 0 1rem;font-size:1.35rem}.prose :global(h3::before){content:'§' counter(chapter) '.' counter(section) '\00a0';color:var(--accent);font-style:normal}.prose :global(h4){counter-increment:subsection;margin:2.2rem 0 .8rem;font-size:1.08rem}.prose :global(h4::before){content:'§' counter(chapter) '.' counter(section) '.' counter(subsection) '\00a0';color:var(--accent)}.prose>:global(p){text-indent:var(--paragraph-indent);text-align:justify}.prose :global(a){color:var(--accent)}.prose :global(blockquote){margin:2.5rem 1.5rem;padding:.25rem 0 .25rem 1.5rem;border-left:2px solid var(--ink);font-style:italic}.prose :global(blockquote p){text-indent:0}.prose :global(pre){position:relative;margin:2rem 0;padding:1.4rem;border:1px solid var(--soft-line);background:var(--surface)!important;overflow:auto;font-size:.82rem}.prose :global(pre code){font-family:var(--font-mono)!important;color:var(--ink)!important}.prose :global(.copy-code){position:absolute;right:.5rem;top:.5rem;min-height:34px;padding:.2rem .55rem;border:1px solid var(--line-color);background:var(--paper);color:var(--ink);cursor:pointer}.prose :global(code:not(pre code)){padding:.08em .25em;border:1px solid var(--soft-line);font-family:var(--font-mono);font-size:.88em}.prose :global(img){width:100%;height:auto;margin:2rem 0}.prose :global(table){width:100%;border-collapse:collapse;font-size:.92rem}.prose :global(th),.prose :global(td){padding:.55rem;border-top:1px solid var(--line-color);border-bottom:1px solid var(--line-color);text-align:left}.prose :global(.katex-display){margin:2rem 0;overflow-x:auto;overflow-y:hidden;padding:.4rem 0}.prose :global(.footnotes){margin-top:4rem;padding-top:1.5rem;border-top:1px solid var(--ink);font-size:.88rem}
  .article-notes{max-width:var(--measure);display:grid;grid-template-columns:1fr 1fr;gap:2rem;padding:2rem 0;border-top:1px solid var(--ink);font-size:.88rem}.article-notes strong{font-variant:small-caps}.article-notes p{margin:.35rem 0}.article-notes button{border:0;padding:0;background:transparent;color:inherit;text-decoration:underline;cursor:pointer}.post-nav{max-width:var(--measure);display:grid;grid-template-columns:1fr 1fr;gap:2rem;padding:2rem 0 5rem}.post-nav a{display:grid;gap:.35rem;min-height:64px;text-decoration:none}.post-nav a:last-child{text-align:right}.post-nav small{font:500 .72rem var(--font-sans);color:var(--muted-ink)}.post-nav strong{font-weight:500}.related .shell{max-width:var(--measure)}
  @media(max-width:1230px){.side-toc{display:none}}
  @media(max-width:620px){.book-toc .depth-3{padding-left:.8rem}.book-toc .depth-4{padding-left:1.6rem}.byline span+span::before,.byline time::before{content:none;margin:0}.article-notes{grid-template-columns:1fr}.post-nav{grid-template-columns:1fr}.post-nav a:last-child{text-align:left}.prose>:global(p){text-align:left}}
</style>
