---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Giscus from '../../components/Giscus.astro';
import GitHubProject from '../../components/GitHubProject.astro';
import { siteConfig } from '../../config/site';
import { adjacentPosts, categoryPosts, collectionPosts, contentStats, formatDate, postSlug, relatedPosts, sortedCollections, visiblePosts } from '../../lib/posts';
import { articlePreviewVersion } from '../../lib/preview-version';
import { articleDisplaySettings, articleTocHeadings, articleTocTextParts } from '../../lib/article-display';
export async function getStaticPaths(){const posts=visiblePosts(await getCollection('blog'),import.meta.env.DEV);return posts.map((post)=>({params:{slug:postSlug(post)},props:{post,posts}}))}
const{post,posts}=Astro.props;const{Content,headings}=await render(post);const slug=postSlug(post);const stats=contentStats(post.body);const related=relatedPosts(post,posts);const index=posts.findIndex((item:typeof post)=>item.id===post.id);const shareUrl=new URL(`/blog/${slug}/`,Astro.site).toString();const allCollections=sortedCollections(await getCollection('collections'));const collection=post.data.collection?allCollections.find(item=>item.id===post.data.collection):undefined;const orderedNavigation=collection?collectionPosts(posts,collection.id):categoryPosts(posts,post.data.category);const adjacent=adjacentPosts(post,orderedNavigation);
const { autoNumbering, showContents, showSideToc } = articleDisplaySettings(post.data);
const tocHeadings=articleTocHeadings(headings,autoNumbering);
---
<BaseLayout title={post.data.title} description={post.data.description} canonical={post.data.canonical} type="article" publishedTime={post.data.publishDate} updatedTime={post.data.updatedDate}>
  <div class="reading-progress" aria-hidden="true"></div>
  <article>
    <header class="article-head shell"><p class="journal">{`Prism Notes · No. ${String(index+1).padStart(3,'0')}`}</p><h1>{post.data.title}</h1><p class="description">{post.data.description}</p><div class="byline"><span>{collection?`${collection.data.title} · 第 ${post.data.collectionOrder} 章`:post.data.category}</span><span>{siteConfig.author.name}</span><time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time><span>{stats.words.toLocaleString('zh-CN')} 字</span><span>约 {stats.minutes} 分钟阅读</span></div><div class="tags">{post.data.tags.map((tag:string)=><a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}</div></header>
    {showContents&&tocHeadings.length>0&&<nav class="book-toc shell" aria-label="文章目录"><header><p>Contents</p><h2>目录</h2></header><ol>{tocHeadings.map((heading:any)=><li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.number&&<span class="toc-number">{heading.number}</span>}<span class="toc-title">{articleTocTextParts(heading.text).map((part)=><>{part.kind==='math'?<span class="toc-inline-math math-source math-source--inline">{part.value}</span>:part.value}</>)}</span><span class="leader" aria-hidden="true"></span><span class="jump" aria-hidden="true">↘</span></a></li>)}</ol></nav>}
    {showSideToc&&tocHeadings.length>0&&<nav class="side-toc" aria-label="随文目录"><p>本页章节</p><ol>{tocHeadings.map((heading:any)=><li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`} data-section={heading.slug}>{heading.number&&<span class="side-toc-number">{heading.number}</span>}<span class="side-toc-title">{articleTocTextParts(heading.text).map((part)=><>{part.kind==='math'?<span class="toc-inline-math math-source math-source--inline">{part.value}</span>:part.value}</>)}</span></a></li>)}</ol><a class="back-top" href="#main-content">返回页首 ↑</a></nav>}
    <div class:list={['prose','shell',{'prose--numbered':autoNumbering}]} data-pagefind-body data-content-version={articlePreviewVersion(post.data,post.body)}><Content components={{ GitHubProject }} /></div>
    <footer class="article-notes shell"><div><strong>引用本文</strong><p>{siteConfig.author.name}. “{post.data.title}.” <em>{siteConfig.name}</em>, {formatDate(post.data.publishDate)}.</p></div><div><strong>分享</strong><p><a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(post.data.title)}`}>X / Twitter</a> · <button id="copy-link" type="button">复制链接</button> <span id="copy-status" role="status" aria-live="polite"></span></p></div></footer>
    <section class="nav-section shell"><header><div><p>Continue reading</p><h2>{collection?'继续阅读本合集':'继续阅读本分类'}</h2></div></header><nav class="post-nav" aria-label={collection?'按合集相邻文章':'按分类相邻文章'}>{adjacent.previous?<a href={`/blog/${postSlug(adjacent.previous)}/`}><small>← {collection?'上一章':'上一篇'} · {collection?.data.title||post.data.category}</small><strong>{adjacent.previous.data.title}</strong></a>:<span></span>}{adjacent.next&&<a href={`/blog/${postSlug(adjacent.next)}/`}><small>{collection?'下一章':'下一篇'} · {collection?.data.title||post.data.category} →</small><strong>{adjacent.next.data.title}</strong></a>}</nav></section>
    {related.length>0&&<section class="section related"><div class="shell"><p class="section-kicker">Related works</p><h2 class="section-heading">相关文字</h2>{related.map((item:any,i:number)=><PostCard post={item} index={i}/>)}</div></section>}
    <div class="shell"><Giscus /></div>
  </article>
</BaseLayout>
<script>
  const progress=document.querySelector<HTMLElement>('.reading-progress');const updateProgress=()=>{if(progress)progress.style.transform=`scaleX(${scrollY/Math.max(1,document.documentElement.scrollHeight-innerHeight)})`};addEventListener('scroll',updateProgress,{passive:true});updateProgress();
  document.querySelector<HTMLButtonElement>('#copy-link')?.addEventListener('click',async()=>{await navigator.clipboard.writeText(location.href);const status=document.querySelector('#copy-status');if(status)status.textContent='已复制'});
  document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre)=>{const button=document.createElement('button');button.className='copy-code';button.type='button';button.textContent='复制';button.setAttribute('aria-label','复制代码');button.addEventListener('click',async()=>{await navigator.clipboard.writeText(pre.innerText.replace(/^复制/,''));button.textContent='已复制';setTimeout(()=>button.textContent='复制',1600)});pre.append(button)});
  const sectionLinks=[...document.querySelectorAll<HTMLAnchorElement>('.side-toc [data-section]')];const sections=sectionLinks.map((link)=>document.getElementById(link.dataset.section||'')).filter(Boolean) as HTMLElement[];
  const setActive=(id:string)=>sectionLinks.forEach((link)=>link.toggleAttribute('aria-current',link.dataset.section===id));
  if(sections.length){setActive(sections[0].id);const observer=new IntersectionObserver((entries)=>{const visible=entries.filter((entry)=>entry.isIntersecting).sort((a,b)=>a.boundingClientRect.top-b.boundingClientRect.top);if(visible[0])setActive((visible[0].target as HTMLElement).id)},{rootMargin:'-15% 0px -70% 0px',threshold:[0,1]});sections.forEach((section)=>observer.observe(section));}
</script>
<style>
  .reading-progress{position:fixed;z-index:200;left:0;top:0;width:100%;height:2px;background:var(--accent);transform:scaleX(0);transform-origin:left}.article-head{max-width:var(--measure);padding:clamp(4rem,10vw,7rem) 0 3rem;text-align:center;border-bottom:1px solid var(--ink)}.journal{font:500 .75rem var(--font-sans);letter-spacing:.11em;text-transform:uppercase;color:var(--muted-ink)}.article-head h1{margin:1.8rem auto 1.2rem;font-size:clamp(2.6rem,7vw,4.8rem);font-weight:500;line-height:1.12}.description{max-width:38rem;margin-inline:auto;font-size:1.15rem;font-style:italic;color:var(--muted-ink)}.byline,.tags{display:flex;justify-content:center;flex-wrap:wrap;gap:.4rem 1rem;margin-top:1.8rem;font:500 .76rem var(--font-sans)}.byline span+span::before,.byline time::before{content:'·';margin-right:1rem;color:var(--muted-ink)}.tags{margin-top:.8rem}.tags a{text-decoration:none}
  .book-toc{max-width:var(--measure);margin-top:2.5rem;padding:2rem clamp(1.25rem,4vw,3rem);border:1px solid var(--line-color);box-shadow:inset 0 0 0 5px var(--paper),inset 0 0 0 6px var(--soft-line)}.book-toc header{text-align:center;margin-bottom:1.5rem}.book-toc header p{margin:0;font:500 .68rem var(--font-sans);letter-spacing:.15em;text-transform:uppercase;color:var(--muted-ink)}.book-toc h2{margin:.2rem 0;font-size:1.65rem;font-weight:500}.book-toc ol{margin:0;padding:0;list-style:none}.book-toc li{margin:.35rem 0}.book-toc a{min-height:40px;display:flex;align-items:baseline;gap:.55rem;text-decoration:none}.book-toc .depth-1{font-size:1rem;font-weight:500}.book-toc .depth-2{padding-left:1.1rem}.book-toc .depth-3{padding-left:2.2rem;font-size:.92rem}.book-toc .depth-4{padding-left:3.3rem;font-size:.88rem}.book-toc .depth-5{padding-left:4.4rem;font-size:.84rem;color:var(--muted-ink)}.book-toc .depth-6{padding-left:5.5rem;font-size:.8rem;color:var(--muted-ink)}.toc-number{flex:0 0 auto;font-variant-numeric:tabular-nums;color:var(--muted-ink)}.toc-title{flex:0 1 auto;min-width:0}.toc-inline-math{display:inline!important;white-space:nowrap}.toc-inline-math :global(mjx-container:not([display='true'])){display:inline-block!important;width:auto!important;max-width:none!important;margin:0!important;white-space:nowrap;vertical-align:-.12em}.leader{flex:1 1 auto;min-width:1rem;border-bottom:1px dotted var(--line-color);transform:translateY(-.25em)}.jump{font-size:.75rem;color:var(--muted-ink)}
  .side-toc{position:fixed;z-index:30;right:2rem;top:100px;width:13.5rem;max-height:calc(100dvh - 130px);overflow:auto;padding-left:1rem;border-left:1px solid var(--soft-line);font-size:.77rem}.side-toc>p{margin:0 0 .8rem;font:500 .66rem var(--font-sans);letter-spacing:.1em;text-transform:uppercase}.side-toc ol{margin:0;padding:0;list-style:none}.side-toc li{margin:.3rem 0}.side-toc .depth-2{padding-left:.55rem}.side-toc .depth-3{padding-left:1.1rem}.side-toc .depth-4{padding-left:1.65rem}.side-toc .depth-5{padding-left:2.2rem}.side-toc .depth-6{padding-left:2.75rem}.side-toc a{display:flex;align-items:baseline;padding:.25rem .4rem;text-decoration:none;color:var(--muted-ink);border-left:2px solid transparent}.side-toc-number{flex:0 0 auto;margin-right:.35rem;font-variant-numeric:tabular-nums}.side-toc-title{min-width:0}.side-toc a[aria-current]{border-left-color:var(--accent);background:color-mix(in srgb,var(--accent) 7%,transparent);color:var(--ink)}.back-top{margin-top:1rem;font-family:var(--font-sans)}
  .prose{max-width:var(--measure);padding-block:clamp(3.5rem,8vw,6rem);font-size:var(--reader-font-size);line-height:var(--reader-line-height)}.prose :global(h1),.prose :global(h2),.prose :global(h3),.prose :global(h4),.prose :global(h5),.prose :global(h6){scroll-margin-top:90px;font-weight:500}.prose :global(h1){margin:3.8rem 0 1.35rem;font-size:2.1rem}.prose :global(h2){margin:3.35rem 0 1.2rem;font-size:1.75rem}.prose :global(h3){margin:2.7rem 0 1rem;font-size:1.4rem}.prose :global(h4){margin:2.3rem 0 .85rem;font-size:1.16rem}.prose :global(h5){margin:2rem 0 .75rem;font-size:1.02rem}.prose :global(h6){margin:1.8rem 0 .7rem;font-size:.94rem}.prose--numbered :global(h1::before),.prose--numbered :global(h2::before),.prose--numbered :global(h3::before),.prose--numbered :global(h4::before),.prose--numbered :global(h5::before),.prose--numbered :global(h6::before){content:attr(data-heading-number) '\00a0';color:var(--accent);font-style:normal;font-variant-numeric:tabular-nums}.prose>:global(p){text-indent:0;text-align:justify}.prose :global(a){color:var(--accent)}.prose :global(blockquote){margin:2.5rem 1.5rem;padding:.25rem 0 .25rem 1.5rem;border-left:2px solid var(--ink);font-style:italic}.prose :global(blockquote p){text-indent:0}.prose :global(pre){position:relative;margin:2rem 0;padding:1.4rem;border:1px solid var(--code-border);background:var(--code-bg)!important;color:var(--code-text);overflow:auto;font-size:.82rem}.prose :global(pre code){font-family:var(--font-mono)!important}.prose :global(.copy-code){position:absolute;right:.5rem;top:.5rem;min-height:34px;padding:.2rem .55rem;border:1px solid var(--code-border);background:var(--paper);color:var(--ink);cursor:pointer}.prose :global(code:not(pre code)){padding:.08em .25em;border:1px solid var(--soft-line);font-family:var(--font-mono);font-size:.88em}.prose :global(img){width:100%;height:auto;margin:2rem 0}.prose :global(table){width:100%;border-collapse:collapse;font-size:.92rem}.prose :global(th),.prose :global(td){padding:.55rem;border-top:1px solid var(--line-color);border-bottom:1px solid var(--line-color);text-align:left}.prose :global(.math-source--display){display:block;max-width:100%;min-width:0;margin:2.25rem 0;text-indent:0}.prose :global(.math-source--inline){text-indent:0}.prose :global(mjx-container){max-width:100%;color:var(--ink);font-weight:400;font-synthesis:none;text-indent:0;line-height:1.2}.prose :global(mjx-container[jax='SVG'] svg){max-width:none!important;fill:currentColor;stroke:currentColor}.prose :global(mjx-container[display='true']){display:block;width:100%;min-width:0;margin:0;padding:1rem 0;overflow:visible!important;text-align:center;text-indent:0;box-sizing:border-box}.prose :global(mjx-container[overflow='linebreak']){overflow:visible!important}.prose :global(.mathjax-error){display:inline-block;padding:.1em .3em;border:1px solid #b3261e;color:#b3261e;font-family:var(--font-mono);font-size:.88em;text-indent:0}.prose :global(.footnotes){margin-top:4rem;padding-top:1.5rem;border-top:1px solid var(--ink);font-size:.88rem}
  :global(:root[data-theme='dark']) .prose :global(.astro-code){background-color:var(--shiki-dark-bg)!important;color:var(--shiki-dark)!important}:global(:root[data-theme='dark']) .prose :global(.astro-code span){color:var(--shiki-dark)!important}
  article,.article-head,.book-toc,.prose,.article-notes,.nav-section{min-width:0}.prose{width:min(100%,var(--measure));overflow-wrap:break-word}.prose :global(h1),.prose :global(h2),.prose :global(h3),.prose :global(h4),.prose :global(h5),.prose :global(h6),.prose :global(p),.prose :global(li),.prose :global(a){overflow-wrap:anywhere}.prose :global(pre),.prose :global(table){max-width:100%}.prose :global(.media-figure){width:min(var(--media-width,100%),100%);max-width:100%;min-width:0;margin:clamp(1.5rem,4vw,2.5rem) auto;text-align:center}.prose :global(.media-figure img){display:block;width:100%;max-width:100%;height:auto;margin:0;object-fit:contain}.prose :global(.media-figure figcaption){margin:.65rem auto 0;max-width:42rem;color:var(--muted-ink);font:400 .82rem/1.5 var(--font-sans);text-align:center}.prose :global(.media-gallery){display:flex;flex-wrap:wrap;align-items:flex-start;justify-content:center;gap:clamp(.75rem,2.4vw,1.5rem);max-width:100%;margin:clamp(1.5rem,4vw,2.75rem) 0}.prose :global(.media-gallery>.media-figure){flex:0 1 calc(var(--media-width,50%) - .75rem);width:auto;min-width:min(12rem,100%);margin:0}
  .article-notes{max-width:var(--measure);display:grid;grid-template-columns:1fr 1fr;gap:2rem;padding:2rem 0;border-top:1px solid var(--ink);font-size:.88rem}.article-notes strong{font-variant:small-caps}.article-notes p{margin:.35rem 0}.article-notes button{border:0;padding:0;background:transparent;color:inherit;text-decoration:underline;cursor:pointer}.nav-section{max-width:var(--measure);padding:2rem 0 5rem}.nav-section>header{display:flex;align-items:end;justify-content:space-between;gap:1rem;border-bottom:1px solid var(--ink)}.nav-section header p{margin:0;font:500 .67rem var(--font-sans);letter-spacing:.1em;text-transform:uppercase;color:var(--muted-ink)}.nav-section h2{margin:.2rem 0 1rem;font-size:1.5rem;font-weight:500}.nav-modes{display:flex}.nav-modes button{min-height:44px;padding:.45rem .75rem;border:1px solid var(--line-color);border-bottom:0;background:transparent;color:var(--ink);cursor:pointer}.nav-modes button[aria-pressed='true']{background:var(--ink);color:var(--paper)}.post-nav{display:grid;grid-template-columns:1fr 1fr;gap:2rem;padding:1.5rem 0 0}.post-nav[hidden]{display:none}.post-nav a{display:grid;gap:.35rem;min-height:64px;text-decoration:none}.post-nav a:last-child{text-align:right}.post-nav small{font:500 .72rem var(--font-sans);color:var(--muted-ink)}.post-nav strong{font-weight:500}.related .shell{max-width:var(--measure)}
  .prose :global(mjx-container:not([display='true'])){vertical-align:-.12em}
  @media(max-width:1230px){.side-toc{display:none}}
  @media(max-width:620px){.article-head,.book-toc,.prose,.article-notes,.nav-section{width:calc(100% - 2rem)}.article-head{padding-top:3.2rem}.article-head h1{font-size:clamp(2.05rem,11vw,3rem)}.book-toc{padding:1.35rem 1rem}.book-toc .depth-2{padding-left:.5rem}.book-toc .depth-3{padding-left:1rem}.book-toc .depth-4,.book-toc .depth-5,.book-toc .depth-6{padding-left:1.5rem}.byline span+span::before,.byline time::before{content:none;margin:0}.article-notes{grid-template-columns:1fr}.post-nav{grid-template-columns:1fr}.post-nav a:last-child{text-align:left}.prose{font-size:max(1rem,var(--reader-font-size));line-height:max(1.7,var(--reader-line-height));padding-block:2.75rem}.prose>:global(p){text-align:left}.prose :global(h1){font-size:1.8rem}.prose :global(h2){font-size:1.5rem}.prose :global(pre){margin-inline:0;padding:1rem;font-size:.78rem}.prose :global(table){display:block;overflow-x:auto;white-space:nowrap}.prose :global(.math-source--display){margin:1.65rem 0}.prose :global(mjx-container){font-size:1.06em}.prose :global(mjx-container[display='true']){padding:.9rem 0;text-align:center}.prose :global(.media-gallery){gap:.75rem}.prose :global(.media-gallery>.media-figure){flex-basis:calc(var(--media-width,50%) - .4rem);min-width:min(9rem,100%)}.prose :global(.media-figure figcaption){font-size:.78rem}}
  @media(max-width:370px){.prose :global(.media-gallery>.media-figure){min-width:min(8rem,100%)}}
  .prose :global(.math-source--display){margin:1rem 0}
  .prose :global(mjx-container[display='true']){padding:.2rem 0}
  .prose :global(blockquote){font-style:normal}
  @media(max-width:620px){.prose :global(.math-source--display){margin:.8rem 0}.prose :global(mjx-container[display='true']){padding:.15rem 0}}
</style>
