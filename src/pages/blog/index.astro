---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LibraryEmpty from '../../components/LibraryEmpty.astro';
import { collectionPosts, contentStats, postSlug, sortedCollections, visiblePosts } from '../../lib/posts';
const posts=visiblePosts(await getCollection('blog'));const collections=sortedCollections(await getCollection('collections'));
---
<BaseLayout title="合集" description="棱镜笔记的主题合集书架。">
  <header class="library-head shell"><div><p class="section-kicker">Library / {String(collections.length).padStart(2,'0')}</p><h1 class="display">合集书架</h1></div><div class="head-note"><span>{posts.filter(post=>post.data.collection).length} 篇章节</span><p>文章按主题组成可连续阅读的书卷。顺序由作者明确编排，与发布日期无关。</p></div></header>
  <main class="library shell">{collections.length?collections.map((collection,index)=>{const chapters=collectionPosts(posts,collection.id);return <article class="book"><aside><span>{collection.data.volume||`卷 ${String(index+1).padStart(2,'0')}`}</span><i aria-hidden="true"></i></aside><div><p class="status">{collection.data.status==='complete'?'已完结':'编写中'} · {chapters.length} 章</p><h2><a href={`/collections/${collection.id}/`}>{collection.data.title}</a></h2>{collection.data.subtitle&&<p class="subtitle">{collection.data.subtitle}</p>}<p>{collection.data.description}</p><ol>{chapters.map(post=>{const stats=contentStats(post.body);return <li><a href={`/blog/${postSlug(post)}/`}><span>第 {post.data.collectionOrder} 章</span><strong>{post.data.title}</strong><i></i><b>{stats.words.toLocaleString('zh-CN')} 字 · 约 {stats.minutes} 分钟</b></a></li>})}</ol></div></article>}):<LibraryEmpty index="Library / 00" title="书架尚待开卷" description="新的主题合集会在这里成为一本可连续阅读的书。当前内容库已清空，等待第一章落笔。" />}</main>
</BaseLayout>
<style>
  .library-head{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(17rem,.7fr);gap:3rem;align-items:end;padding:clamp(4.5rem,10vw,8rem) 0 clamp(2.5rem,5vw,4rem);border-bottom:1px solid var(--ink)}.library-head h1{margin:.35rem 0 0}.head-note{padding-left:1.5rem;border-left:1px solid var(--line-color)}.head-note span{font:500 .68rem var(--font-sans);letter-spacing:.1em;text-transform:uppercase}.head-note p{margin:.75rem 0 0;color:var(--muted-ink)}
  .library{display:grid;gap:2rem;padding-block:2rem 7rem}.book{display:grid;grid-template-columns:7rem 1fr;border:1px solid var(--line-color);background:var(--surface)}.book>aside{display:flex;flex-direction:column;justify-content:space-between;padding:1.5rem;border-right:1px solid var(--line-color);background:color-mix(in srgb,var(--accent) 7%,var(--paper));writing-mode:vertical-rl}.book>aside span{font:500 .7rem var(--font-sans);letter-spacing:.12em}.book>aside i{height:5rem;border-left:1px solid var(--accent);transform:rotate(20deg)}.book>div{padding:clamp(1.5rem,5vw,3rem)}.status{margin:0;font:500 .7rem var(--font-sans);letter-spacing:.1em;text-transform:uppercase;color:var(--muted-ink)}.book h2{margin:.5rem 0;font-size:clamp(2rem,5vw,3.2rem);font-weight:500}.book h2 a{text-decoration:none}.subtitle{font-style:italic}.book ol{padding:0;list-style:none;border-top:1px solid var(--line-color)}.book li{border-bottom:1px solid var(--soft-line)}.book li a{display:flex;align-items:baseline;gap:.75rem;min-height:52px;padding:.7rem 0;text-decoration:none}.book li span{font-size:.78rem;color:var(--muted-ink)}.book li strong{font-weight:500}.book li i{flex:1;border-bottom:1px dotted var(--line-color)}.book li b{font:400 .7rem var(--font-sans);color:var(--muted-ink);white-space:nowrap}
  @media(max-width:720px){.library-head{grid-template-columns:1fr;gap:1.5rem}.head-note{padding-left:0;border-left:0}.book{grid-template-columns:3rem 1fr}.book>aside{padding:.8rem}.book li a{display:grid;grid-template-columns:auto 1fr}.book li i{display:none}.book li b{grid-column:2}}
</style>
