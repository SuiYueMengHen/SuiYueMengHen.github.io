---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectionPosts, contentStats, postSlug, sortedCollections, visiblePosts } from '../../lib/posts';
const posts=visiblePosts(await getCollection('blog'));const collections=sortedCollections(await getCollection('collections'));
---
<BaseLayout title="合集" description="棱镜笔记的主题合集书架。">
  <header class="page-head shell"><p class="section-kicker">Library / {posts.length}</p><h1 class="display">合集书架</h1><p>文章按主题组成可连续阅读的书卷；目录顺序由作者明确编排，与发布日期无关。</p></header>
  <section class="library shell">{collections.map((collection,index)=>{const chapters=collectionPosts(posts,collection.id);return <article class="book"><aside><span>{collection.data.volume||`卷 ${String(index+1).padStart(2,'0')}`}</span><i aria-hidden="true"></i></aside><div><p class="status">{collection.data.status==='complete'?'已完结':'编写中'} · {chapters.length} 章</p><h2><a href={`/collections/${collection.id}/`}>{collection.data.title}</a></h2>{collection.data.subtitle&&<p class="subtitle">{collection.data.subtitle}</p>}<p>{collection.data.description}</p><ol>{chapters.map(post=>{const stats=contentStats(post.body);return <li><a href={`/blog/${postSlug(post)}/`}><span>第 {post.data.collectionOrder} 章</span><strong>{post.data.title}</strong><i></i><b>{stats.words.toLocaleString('zh-CN')} 字 · 约 {stats.minutes} 分钟</b></a></li>})}</ol></div></article>})}</section>
</BaseLayout>
<style>
  .library{display:grid;gap:2rem;padding-bottom:7rem}.book{display:grid;grid-template-columns:7rem 1fr;border:1px solid var(--line-color);background:var(--surface)}.book>aside{display:flex;flex-direction:column;justify-content:space-between;padding:1.5rem;border-right:1px solid var(--line-color);background:color-mix(in srgb,var(--accent) 7%,var(--paper));writing-mode:vertical-rl}.book>aside span{font:500 .7rem var(--font-sans);letter-spacing:.12em}.book>aside i{height:5rem;border-left:1px solid var(--accent);transform:rotate(20deg)}.book>div{padding:clamp(1.5rem,5vw,3rem)}.status{margin:0;font:500 .7rem var(--font-sans);letter-spacing:.1em;text-transform:uppercase;color:var(--muted-ink)}.book h2{margin:.5rem 0;font-size:clamp(2rem,5vw,3.2rem);font-weight:500}.book h2 a{text-decoration:none}.subtitle{font-style:italic}.book ol{padding:0;list-style:none;border-top:1px solid var(--line-color)}.book li{border-bottom:1px solid var(--soft-line)}.book li a{display:flex;align-items:baseline;gap:.75rem;min-height:52px;padding:.7rem 0;text-decoration:none}.book li span{font-size:.78rem;color:var(--muted-ink)}.book li strong{font-weight:500}.book li i{flex:1;border-bottom:1px dotted var(--line-color)}.book li b{font:500 .7rem var(--font-sans);font-weight:400;color:var(--muted-ink);white-space:nowrap}@media(max-width:620px){.book{grid-template-columns:3rem 1fr}.book>aside{padding:.8rem}.book li a{display:grid;grid-template-columns:auto 1fr}.book li i{display:none}.book li b{grid-column:2}}
</style>
