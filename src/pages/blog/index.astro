---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { visiblePosts } from '../../lib/posts';
import '../../styles/blog.css';
const posts = visiblePosts(await getCollection('blog'), import.meta.env.DEV);
---

<BaseLayout title="Blog" description="一些思考与记录。">
  <div class="blog-shell">
    <header class="blog-heading">
      <h1>Blog</h1>
      <p>一些思考与记录。</p>
    </header>
    <section aria-label="文章列表">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
      {!posts.length && <p class="muted">还没有发布的文章。</p>}
    </section>
    <nav class="blog-links" aria-label="博客链接">
      <a href="/tags/">标签</a>
      <a href="/rss.xml">RSS ↗</a>
    </nav>
  </div>
</BaseLayout>
