---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="搜索" description="搜索棱镜笔记的全部文章。"><header class="page-head shell"><p class="section-kicker">Full-text index</p><h1 class="display">搜索</h1><p>输入标题、正文、标签或分类。全文索引仅在当前浏览器中查询。</p></header><section class="search-section"><div class="shell search-box"><label for="search-input">查询词</label><div class="input-row"><input id="search-input" type="search" placeholder="例如：设计、写作、技术" autocomplete="off" /><button id="search-button" type="button">检索</button></div><p id="search-status" role="status" aria-live="polite">输入关键词开始搜索</p><div id="search-results"></div></div></section></BaseLayout>
<script>
  const input=document.querySelector<HTMLInputElement>('#search-input');const button=document.querySelector<HTMLButtonElement>('#search-button');const results=document.querySelector<HTMLElement>('#search-results');const status=document.querySelector<HTMLElement>('#search-status');let pagefind:any;
  async function search(query:string){if(!results||!status)return;if(!query.trim()){results.innerHTML='';status.textContent='输入关键词开始搜索';return}try{const loadModule=new Function('path','return import(path)') as(path:string)=>Promise<any>;pagefind||=await loadModule('/pagefind/pagefind.js');const response=await pagefind.search(query);const items=await Promise.all(response.results.slice(0,20).map((item:any)=>item.data()));status.textContent=`找到 ${response.results.length} 条结果`;results.innerHTML=items.map((item:any,index:number)=>`<article><span>${String(index+1).padStart(2,'0')}.</span><a href="${item.url}"><small>${item.meta.category||'文章'}</small><h2>${item.meta.title}</h2><p>${item.excerpt}</p></a></article>`).join('')}catch{status.textContent='开发模式下暂不生成搜索索引；运行 npm run build 后即可使用。'}}
  let timer:number;input?.addEventListener('input',()=>{clearTimeout(timer);timer=window.setTimeout(()=>search(input.value),180)});button?.addEventListener('click',()=>search(input?.value||''));
</script>
<style>.search-section{padding-bottom:8rem}.search-box{max-width:var(--measure)}.search-box label{display:block;margin-bottom:.5rem;font-weight:500}.input-row{display:grid;grid-template-columns:1fr auto}.input-row input{width:100%;min-height:52px;padding:.65rem .85rem;border:1px solid var(--ink);border-radius:0;background:var(--surface);color:var(--ink);font-size:1rem}.input-row button{min-width:84px;border:1px solid var(--ink);border-left:0;background:var(--ink);color:var(--paper);cursor:pointer}#search-status{font:500 .75rem var(--font-sans);color:var(--muted-ink)}#search-results{border-top:1px solid var(--ink);margin-top:2rem}#search-results :global(article){display:grid;grid-template-columns:2rem 1fr;gap:1rem;padding:1.5rem 0;border-bottom:1px solid var(--soft-line)}#search-results :global(article>a){text-decoration:none}#search-results :global(h2){margin:.25rem 0;font-size:1.45rem;font-weight:500}#search-results :global(p){margin:.45rem 0;color:var(--muted-ink)}#search-results :global(mark){background:color-mix(in srgb,var(--accent) 18%,transparent);color:inherit}</style>
