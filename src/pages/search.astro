---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="搜索" description="搜索棱镜笔记的全部文章。">
  <header class="page-head shell"><p class="section-kicker">Search the spectrum</p><h1 class="display">搜索</h1><p>输入标题、正文、标签或分类，索引完全在浏览器本地查询。</p></header>
  <section class="search-section"><div class="shell search-box"><label for="search-input">搜索全部文章</label><div class="input-row"><input id="search-input" type="search" placeholder="例如：设计、写作、技术……" autocomplete="off" /><span aria-hidden="true">⌕</span></div><p id="search-status" role="status" aria-live="polite">输入关键词开始搜索</p><div id="search-results"></div></div></section>
</BaseLayout>
<script>
  const input=document.querySelector<HTMLInputElement>('#search-input');const results=document.querySelector<HTMLElement>('#search-results');const status=document.querySelector<HTMLElement>('#search-status');let pagefind:any;
  async function search(query:string){if(!results||!status)return; if(!query.trim()){results.innerHTML='';status.textContent='输入关键词开始搜索';return}try{const loadModule=new Function('path','return import(path)') as (path:string)=>Promise<any>;pagefind ||= await loadModule('/pagefind/pagefind.js');const response=await pagefind.search(query);const items=await Promise.all(response.results.slice(0,20).map((item:any)=>item.data()));status.textContent=`找到 ${response.results.length} 条结果`;results.innerHTML=items.map((item:any)=>`<article><a href="${item.url}"><small>${item.meta.category||'文章'}</small><h2>${item.meta.title}</h2><p>${item.excerpt}</p></a></article>`).join('')}catch{status.textContent='开发模式下暂不生成搜索索引；运行 npm run build 后即可使用。'}}
  let timer:number;input?.addEventListener('input',()=>{clearTimeout(timer);timer=window.setTimeout(()=>search(input.value),180)});
</script>
<style>.search-section{padding-bottom:8rem}.search-box{max-width:900px}.search-box label{display:block;margin-bottom:.75rem;font-weight:750}.input-row{position:relative}.input-row input{width:100%;min-height:72px;padding:1rem 4rem 1rem 1.25rem;border:3px solid var(--ink);border-radius:0;background:var(--surface);color:var(--ink);font-size:1.25rem}.input-row span{position:absolute;right:1.2rem;top:50%;transform:translateY(-50%);font-size:2rem}#search-status{font:.75rem var(--font-mono);color:var(--muted-ink)}#search-results{border-top:var(--line);margin-top:2rem}#search-results :global(article){border-bottom:var(--line)}#search-results :global(a){display:block;padding:1.5rem 0;text-decoration:none}#search-results :global(a:hover h2){color:var(--red)}#search-results :global(h2){margin:.4rem 0;font-size:1.8rem}#search-results :global(p){color:var(--muted-ink)}#search-results :global(mark){background:var(--yellow);color:#151514}</style>
